       let method = class_getClassMethod(session, NSSelectorFromString("testmanagerdServiceName")) {
        let name: @convention(block) (AnyObject) -> NSString = { _ in "com.apple.dt.testmanagerd.runner" }
        method_setImplementation(method, imp_implementationWithBlock(name))
    }
    if let configClass = NSClassFromString("XCTestConfiguration") as? NSObject.Type {
        let config = configClass.init()
        config.setValue(true, forKey: "initializeForUITesting")
