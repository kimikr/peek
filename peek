                                     ("XCUIApplication", "_waitForQuiescenceAsPreEvent:", settleWithFlag),
                                     ("XCAXClient_iOS", "waitForQuiescenceOnAllForegroundApplicationsAsPreEvent:", settleWithFlag)] {
