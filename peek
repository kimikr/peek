/// turn on Automation Mode; peek does both itself. iOS 27 renamed the daemon's Mach service.
@MainActor func __peekPrepareUITesting() {
    guard FileManager.default.fileExists(atPath: "/System/Developer/usr/libexec/testmanagerd") else {
        print("peek: UI tests need the developer disk image (testmanagerd); mount it with StikDebug, then reopen Peek")
        __peekNotice("UI tests need the developer disk image.\\nMount it with StikDebug, then reopen Peek.")
        return
