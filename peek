    // this process, whose main thread is busy running the test, so that wait only ends at its
    // ~30 s timeout. Let the app's run loop turn for a moment, and until scrolling has stopped
    // (a tap on a list still coasting after a swipe would only stop it).
    let settle: @convention(block) (AnyObject) -> Void = { _ in __peekSettle(0.3) }
    let settleWithFlag: @convention(block) (AnyObject, Bool) -> Void = { _, _ in __peekSettle(0.3) }
    // Activating or launching an app waits the same way (60 s for an idle notification only an
    // injected agent sends). Give the app a second to draw instead.
    let settleApp: @convention(block) (AnyObject, Bool, Bool) -> Void = { _, _, _ in RunLoop.current.run(until: Date().addingTimeInterval(1)) }
    let settleAppActivity: @convention(block) (AnyObject, Bool, AnyObject?, Bool) -> Void = { _, _, _, _ in RunLoop.current.run(until: Date().addingTimeInterval(1)) }
    for (className, name, block) in [("XCUIApplicationProcess", "waitForQuiescenceIncludingAnimationsIdle:isPreEvent:", settleApp as Any),
                                     ("XCUIApplicationProcess", "waitForQuiescenceIncludingAnimationsIdle:usingActivity:isPreEvent:", settleAppActivity),
