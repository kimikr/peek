XCTEST_RUNNER = """
import XCTest
import ObjectiveC
import AVFoundation
import CoreLocation

let __peekUsesUITesting = %UITESTS%
let __peekTargetBundleIdentifier = %TARGETBUNDLE%

/// Runs the XCTestCase subclasses defined in this build and prints XCTest's usual log. Only this
/// library's classes are looked at: earlier builds stay loaded, and touching arbitrary classes of
/// the process (some are not NSObjects) can crash. Returns whether they all passed.
@MainActor func __peekRunXCTests(module: String) -> Bool {
    var info = Dl_info()
    guard dladdr(#dsohandle, &info) != 0, let image = info.dli_fname else { return false }
    var count: UInt32 = 0
    guard let names = objc_copyClassNamesForImage(image, &count) else { return true }
    defer { free(UnsafeMutableRawPointer(mutating: names)) }
    let base = ObjectIdentifier(XCTestCase.self)
    var classes: [AnyClass] = []
    for index in 0..<Int(count) {
        guard let candidate = objc_getClass(names[index]) as? AnyClass else { continue }
        var parent: AnyClass? = class_getSuperclass(candidate)
        while let current = parent, ObjectIdentifier(current) != base { parent = class_getSuperclass(current) }
        if parent != nil { classes.append(candidate) }
    }
    if classes.isEmpty { return true }
    let suite = XCTestSuite(name: "All tests")
    let filter = __peekTestFilter.isEmpty ? nil : try? NSRegularExpression(pattern: __peekTestFilter)
    if !__peekTestFilter.isEmpty, filter == nil {
        print("peek: --filter is not a valid regular expression: \\(__peekTestFilter)")
        return false
    }
    for testClass in classes.sorted(by: { NSStringFromClass($0) < NSStringFromClass($1) }) {
        let classSuite = XCTestSuite(forTestCaseClass: testClass)
        guard let filter else { suite.addTest(classSuite); continue }
        let matching = XCTestSuite(name: classSuite.name)
        for test in classSuite.tests {
            let name = __peekTestName(test)
            if filter.firstMatch(in: name, range: NSRange(name.startIndex..., in: name)) != nil { matching.addTest(test) }
        }
        if matching.testCaseCount > 0 { suite.addTest(matching) }
    }
    if suite.testCaseCount == 0 { return true }
    if __peekUsesUITesting {
        __peekPrepareUITesting()
        __peekStartAccessibility()
        __PeekBackgroundKeeper.shared.start()
    } else {
        __peekWithoutTestDaemon()
    }
    let observer = __PeekFailureObserver()
    XCTestObservationCenter.shared.addTestObserver(observer)
    suite.run()
    XCTestObservationCenter.shared.removeTestObserver(observer)
    if __peekUsesUITesting { __PeekBackgroundKeeper.shared.stop() }
    return suite.testRun?.hasSucceeded ?? false
}

/// "Class/method" for "-[Module.Class method]".
func __peekTestName(_ test: XCTest) -> String {
    let parts = test.name.trimmingCharacters(in: CharacterSet(charactersIn: "-[]")).split(separator: " ")
    let type = parts.first.map { $0.split(separator: ".").last.map(String.init) ?? String($0) } ?? test.name
    return parts.count > 1 ? "\\(type)/\\(parts[1])" : type
}

final class __PeekFailureObserver: NSObject, XCTestObservation {
    func testCaseDidFinish(_ testCase: XCTestCase) {
        if let run = testCase.testRun, !run.hasSucceeded { __peekFailedTests.append(__peekTestName(testCase)) }
    }
