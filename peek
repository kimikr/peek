# Compiled once and kept by incremental builds: helpers the rewritten sources refer to.
SUPPORT_SOURCE = """\
// Generated by peek. Do not edit.
import SwiftUI
import UIKit

// A #Preview body may produce a SwiftUI view, a view controller or a UIKit view.
func __peekPreview<V: SwiftUI.View>(@SwiftUI.ViewBuilder _ make: () -> V) -> SwiftUI.AnyView {
    SwiftUI.AnyView(make())
}

