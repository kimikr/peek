# ------------------------------------------------------------------ package

SWIFTPM_NOISE = re.compile(r"Building for debugging|Build complete!|\[Starting\]|\[Using on-disk description\]|"
                           r"warning: argument unused during compilation|^\s*$|^\s*\[\d+ / \d+\]")


def swiftpm_summary(lines):
    """The lines of a SwiftPM build worth reading: no progress chatter, no repeated failures, and
    not the full compiler command SwiftBuild prints under a failed step."""
    out, in_command = [], False
    for line in lines:
        if re.match(r"error: (CompileC|CompileSwift|SwiftCompile|Ld|Libtool|SwiftDriver)\b", line):
            out.append(line.split(" /", 1)[0] + " failed")
            in_command = True
            continue
        if in_command and (line.startswith(" ") or not line.strip()):
            continue
        in_command = False
        if not SWIFTPM_NOISE.search(line):
            out.append(line)
    return list(dict.fromkeys(out))  # SwiftBuild repeats a failure once per file


def clean_swiftpm_line(line):
    """SwiftBuild prints failed commands with their whole environment (`env -i 'KEY=value' …`),
    which can hold secrets and would be shown on the phone: drop the variables."""
    line = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line)  # clang's colours
    if "env -i" not in line:
        return line
    return re.sub(r"(?:'[A-Za-z_][A-Za-z0-9_]*=(?:[^']|'\\'')*' ?)+", "… ", line)


class Package:
    """A SwiftPM package whose dependencies are built once by SwiftPM."""

    SKIP_TYPES = {"test", "plugin", "macro", "system-target", "binary", "snippet"}

    def __init__(self, root, toolchain, wanted, scratch, tests=False):
        self.root, self.tc, self.scratch = root, toolchain, scratch
        self.products = scratch / "out/Products/Debug-iphoneos"
        swift = Path(toolchain.swiftc).with_name("swift")
        proc = subprocess.run([str(swift) if swift.exists() else "swift", "package", "describe", "--type", "json"],
                              cwd=root, capture_output=True, text=True, env=toolchain.swift_env())
        if proc.returncode != 0:
            raise ValueError((proc.stderr or proc.stdout).strip() or "could not read Package.swift")
        info = json.loads(proc.stdout[proc.stdout.index("{"):])
        self.name = info["name"]
        targets = {t["name"]: t for t in info["targets"] if t.get("type") not in self.SKIP_TYPES}
        if not targets:
            raise ValueError("Package.swift has no library or executable target to preview")
        if not wanted and (root / "xtool.yml").exists():
            m = re.search(r"^product:\s*(\S+)", (root / "xtool.yml").read_text(), re.M)
            wanted = m.group(1) if m else None
        products = {p["name"]: p["targets"] for p in info.get("products", [])}
        self.product_names = set(products)
        if wanted and wanted not in targets:
            wanted = next((t for t in products.get(wanted, []) if t in targets), wanted)
        if not wanted:
            libraries = [p["targets"][0] for p in info.get("products", [])
                         if "library" in p.get("type", {}) and p["targets"] and p["targets"][0] in targets]
            wanted = libraries[0] if libraries else next(iter(targets))
        if wanted not in targets:
            raise ValueError(f"no target named {wanted}; targets: {', '.join(targets)}")
        target = targets[wanted]
        self.target = wanted
        self.target_dir = (root / target["path"]).resolve()
        self.bundle_name = f"{self.name}_{wanted}" if target.get("resources") else None
        # With tests, the test targets that depend on the previewed target are compiled into the
        # same module, so their own dependencies are needed as well.
        self.test_targets = [t for t in info["targets"] if t.get("type") == "test"
                             and wanted in (t.get("target_dependencies") or [])] if tests else []
        if tests and not self.test_targets:
            raise ValueError(f"no test target depends on {wanted}")
        self.test_dirs = [(root / t["path"]).resolve() for t in self.test_targets]
        direct = list(dict.fromkeys(list(target.get("target_dependencies") or []) + [
            d for t in self.test_targets for d in t.get("target_dependencies") or [] if d != wanted]))
        products = list(dict.fromkeys(list(target.get("product_dependencies") or []) + [
            d for t in self.test_targets for d in t.get("product_dependencies") or []]))
        needed, queue = set(), [wanted] + [d for d in direct if d in targets]
        needed.update(queue[1:])
        while queue:
            for dep in targets.get(queue.pop(), {}).get("target_dependencies", []):
                if dep not in needed:
                    needed.add(dep)
                    queue.append(dep)
        # Objects that must not be linked: the previewed module itself and unrelated local targets.
        self.excluded = {t["c99name"] for name, t in targets.items() if name not in needed}
        self.local_deps = [Path(d["path"]) for d in info.get("dependencies", []) if d.get("type") == "fileSystem"]
        # What the previewed target depends on directly, and where those sources live: an edit
        # there only needs these built, not the previewed target (peek compiles that itself).
        everything = {t["name"]: t for t in info["targets"]}
        self.direct_targets = [t for t in direct if t in targets]
        # Macro targets cannot be built on their own (SwiftBuild has a host and a device copy of
        # each and refuses the name), so a package with local macros is built as a whole.
        self.local_macros = [n for n in needed | set(direct)
                             if everything.get(n, {}).get("type") == "macro"]
        # Binary targets cannot be built on their own, so peek unpacks those it needs (stage_binaries).
        self.binaries = {n: everything[n].get("path") for n in needed | set(direct)
                         if everything.get(n, {}).get("type") == "binary"}
        # The previewed target's resources: peek assembles its bundle (SwiftPM would need actool
        # for asset catalogs, which only exists on a Mac).
        self.resources = [(Path(r["path"]), "copy" if "copy" in (r.get("rule") or {}) else "process")
                          for r in target.get("resources") or []]
        self.direct_products = products
        self.dep_dirs = [(root / targets[n]["path"]).resolve() for n in needed if n in targets] \
            + [d.resolve() for d in self.local_deps]
        # SwiftPM names the root package after its folder; `package` declarations need the same name.
        self.identity = root.name.lower()
        # C++ in the target or anything it depends on needs the C++ standard library at link time.
        self.cxx = any(Path(src).suffix in (".cpp", ".cc", ".cxx", ".c++", ".mm")
                       for name in needed | {wanted} for src in targets.get(name, {}).get("sources", []))
        self.settings(swift, wanted)
        if self.cxx:
            self.link_flags.append("-lc++")

    def settings(self, swift, wanted):
        """Build settings of the previewed target from Package.swift: language mode and swiftSettings."""
        self.language_mode, self.swift_flags, self.link_flags = None, [], []
        self.default_localization = None
        proc = subprocess.run([str(swift) if swift.exists() else "swift", "package", "dump-package"],
                              cwd=self.root, capture_output=True, text=True, env=self.tc.swift_env())
        try:
            manifest = json.loads(proc.stdout[proc.stdout.index("{"):])
        except ValueError:
            return
        self.default_localization = manifest.get("defaultLocalization")
        tools = manifest.get("toolsVersion", {}).get("_version", "5")
        modes = manifest.get("swiftLanguageModes") or manifest.get("swiftLanguageVersions") or []
        modes = [m.get("_0", m) if isinstance(m, dict) else m for m in modes]
        self.language_mode = str(modes[0]) if modes else ("6" if int(tools.split(".")[0]) >= 6 else "5")
        target = next((t for t in manifest.get("targets", []) if t.get("name") == wanted), {})
        for setting in target.get("settings", []):
            condition = setting.get("condition") or {}
            if condition.get("platformNames") and "ios" not in condition["platformNames"]:
                continue
            if condition.get("config") not in (None, "debug"):
                continue
            kinds = setting.get("kind")
            if not isinstance(kinds, dict) or len(kinds) != 1:
                continue
            (kind, value), = kinds.items()
            value = value.get("_0") if isinstance(value, dict) else value
            tool = setting.get("tool")
            if kind == "swiftLanguageMode" and value:
                self.language_mode = str(value)
            elif kind == "interoperabilityMode" and value == "Cxx":
                self.swift_flags.append("-cxx-interoperability-mode=default")
                self.cxx = True
            elif kind == "define" and tool == "swift":
                self.swift_flags += ["-D", value]
            elif kind == "enableUpcomingFeature":
                self.swift_flags += ["-enable-upcoming-feature", value]
            elif kind == "enableExperimentalFeature":
                self.swift_flags += ["-enable-experimental-feature", value]
            elif kind == "defaultIsolation" and isinstance(value, str):
                self.swift_flags += ["-default-isolation", value]
            elif kind == "unsafeFlags" and tool == "swift":
                self.swift_flags += list(value)
            elif kind == "unsafeFlags" and tool == "linker":
                self.link_flags += list(value)
            elif kind == "linkedFramework":
                self.link_flags += ["-framework", value]
            elif kind == "linkedLibrary":
                self.link_flags += [f"-l{value}"]

    def build(self, dependencies_only=False):
        """Builds what the previewed target depends on (peek compiles the target itself).

        The previewed target is never built by SwiftPM: that would compile it twice, and an asset
        catalog in it would stop the whole build on Linux (no actool)."""
        runs = [("--target", t) for t in self.direct_targets] + [("--product", p) for p in self.direct_products]
        output, ok = [], True
        if self.local_macros and not dependencies_only:
            # Builds the previewed target too; only the macros matter, so its failure is ignored
            # unless a macro did not get built.
            proc = self.tc.swift_build(self.root, self.scratch)
            missing = [m for m in self.local_macros if not any(
                (folder / m).exists() for folder in self.products.parent.glob("Debug-*"))]
            if missing:
                output += [clean_swiftpm_line(l) for l in (proc.stdout + proc.stderr).splitlines()
                           if not re.fullmatch(r"\[\d+ / \d+\].*", l)]
                output.append(f"error: macro {', '.join(missing)} could not be built")
                ok = False
        for extra in runs:
            proc = self.tc.swift_build(self.root, self.scratch, extra)
            output += [clean_swiftpm_line(l) for l in (proc.stdout + proc.stderr).splitlines()
                       if not re.fullmatch(r"\[\d+ / \d+\].*", l)]
            ok = ok and proc.returncode == 0
        if not dependencies_only:
            try:
                self.stage_binaries()
            except (OSError, ValueError) as e:
                output.append(f"error: {e}")
                ok = False
        output = swiftpm_summary(output)
        if not ok and any("actool" in l or "xcstringstool" in l for l in output):
            output.append("note: a dependency has an asset catalog or a string catalog; SwiftPM needs "
                          "Xcode's tools to build those, which only exist on a Mac.")
        return ok, "\n".join(output).strip()

    @property
    def staged(self):
        return self.scratch / "peek-binaries"

    def _find_binary(self, name, path):
        if path and (self.root / path).exists():
            return self.root / path
        found = sorted((self.scratch / "artifacts").rglob(f"{name}.xcframework"))
        if not found:  # a remote binary target: download it first
            swift = Path(self.tc.swiftc).with_name("swift")
            subprocess.run([str(swift) if swift.exists() else "swift", "package", "resolve", "--scratch-path",
                            str(self.scratch)], cwd=self.root, capture_output=True, env=self.tc.swift_env())
            found = sorted((self.scratch / "artifacts").rglob(f"{name}.xcframework"))
        if not found:
            raise ValueError(f"binary target {name}: no .xcframework found")
        return found[0]

    def stage_binaries(self):
        """Unpacks the iOS device slice of each .xcframework the previewed target needs:
        frameworks and static libraries into peek-binaries/, headers into peek-binaries/include/<name>."""
        shutil.rmtree(self.staged, ignore_errors=True)
        if not self.binaries:
            return
        self.staged.mkdir(parents=True)
        for name, path in sorted(self.binaries.items()):
            xcframework = self._find_binary(name, path)
            with open(xcframework / "Info.plist", "rb") as f:
                info = plistlib.load(f)
            slice_ = next((l for l in info.get("AvailableLibraries", [])
                           if l.get("SupportedPlatform") == "ios" and not l.get("SupportedPlatformVariant")
                           and "arm64" in l.get("SupportedArchitectures", [])), None)
            if not slice_:
                raise ValueError(f"{xcframework.name} has no iOS device (arm64) library")
            folder = xcframework / slice_["LibraryIdentifier"]
            library = folder / slice_["LibraryPath"]
            if (self.products / library.name).exists():
                continue  # a dependency uses it too, so SwiftPM has unpacked it already
            if library.is_dir():
                shutil.copytree(library, self.staged / library.name, symlinks=True)
            else:
                shutil.copy2(library, self.staged / library.name)
            if slice_.get("HeadersPath"):
                shutil.copytree(folder / slice_["HeadersPath"], self.staged / "include" / name, symlinks=True)

    def header_paths(self):
        return sorted(p for p in (self.staged / "include").glob("*") if p.is_dir())

    def only_dependency_sources(self, paths):
        """True when every changed path is a Swift source of a dependency."""
        return bool(paths) and all(p.suffix == ".swift" and any(d in p.parents for d in self.dep_dirs) for p in paths)

    def objects(self):
        """Object files of the dependencies, plus static libraries from binary (.xcframework) targets."""
        built = {f"lib{name}.a" for name in self.product_names}
        staged = {a.name for a in self.staged.glob("*.a")}  # SwiftPM may have copied the same library
        return [o for o in sorted(self.products.glob("*.o")) if o.stem not in self.excluded] + \
            [a for a in sorted(self.products.glob("*.a")) if a.name not in built | staged] + sorted(self.staged.glob("*.a"))

    def frameworks(self):
        """Frameworks from binary (.xcframework) targets, static or dynamic."""
        staged = {f.name: f for f in self.staged.glob("*.framework") if f.is_dir()}
        built = {f.name: f for f in self.products.glob("*.framework") if f.is_dir() and f.name not in staged}
        return sorted({**built, **staged}.values())

    def dynamic_frameworks(self):
        """The frameworks whose binary is a dynamic library: signed and shipped to the phone.

        A static framework holds an `ar` archive; it is linked into the builds instead."""
        found = []
        for framework in self.frameworks():
            binary = framework / framework.stem
            try:
                with open(binary, "rb") as f:
                    static = f.read(8) == b"!<arch>\n"
            except OSError:
                continue
            if not static:
                found.append(framework)
        return found

    def module_maps(self):
        """-Xcc -fmodule-map-file flags for the C, Objective-C and C++ targets SwiftPM built.

        SwiftPM writes a module map per target; Swift code imports those modules through them."""
        folder = self.scratch / "out/Intermediates.noindex/GeneratedModuleMaps-iphoneos"
        flags = []
        for path in sorted(folder.glob("*.modulemap")):
            if path.stem not in self.excluded:  # the previewed target's own (Swift) module
                flags += ["-Xcc", f"-fmodule-map-file={path}"]
        return flags

    def macro_plugins(self):
        """-load-plugin-executable flags for the host executables SwiftPM built.

        All executables are passed; swiftc only runs one when a macro from its module is used."""
        flags = []
        for folder in sorted(self.products.parent.glob("Debug-*")):
            if folder == self.products or folder.name.endswith(("iphoneos", "iphonesimulator")):
                continue
            for exe in sorted(folder.iterdir()):
                if exe.is_file() and os.access(exe, os.X_OK) and not exe.suffix:
                    flags += ["-load-plugin-executable", f"{exe}#{exe.name}"]
        return flags

    def bundles(self):
        return sorted(p for p in self.products.glob("*.bundle") if p.is_dir())


def walk_files(base, skip=None):
    for dirpath, dirs, files in os.walk(base):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS and not d.startswith("."))
        for f in sorted(files):
            path = Path(dirpath) / f
            if not f.startswith(".") and not (skip and skip(path)):
                yield path


def _color_component(value):
    value = str(value).strip()
    if value.lower().startswith("0x"):
        return int(value, 16) / 255
    if "." in value:
        return float(value)
    number = float(value)
    return number / 255 if number > 1 else number


def asset_colors(catalogs):
    """Colour sets of asset catalogs as {name: {"any": spec, "dark": spec}}.

    A spec is ("srgb" | "display-p3", red, green, blue, alpha) or ("system", selector name).
    """
    colors = {}
    for catalog in catalogs:
        for colorset in sorted(catalog.rglob("*.colorset")):
            try:
                entries = json.loads((colorset / "Contents.json").read_text()).get("colors", [])
            except (OSError, ValueError):
                continue
            found = {}
            for entry in entries:
                color = entry.get("color") or {}
                if entry.get("idiom", "universal") not in ("universal", "iphone") or \
                        color.get("platform", "ios") not in ("ios", "universal"):
                    continue
                appearances = entry.get("appearances") or []
                if any(a.get("appearance") != "luminosity" for a in appearances):
                    continue  # high contrast variants
                look = "dark" if any(a.get("value") == "dark" for a in appearances) else \
                    "light" if appearances else "any"
                try:
                    if color.get("reference"):
                        spec = ("system", color["reference"])
                    else:
                        c = color.get("components", {})
                        spec = (color.get("color-space", "srgb"), *(_color_component(c.get(k, "1" if k == "alpha" else "0"))
                                                                    for k in ("red", "green", "blue", "alpha")))
                except ValueError:
                    continue
                found[look] = spec
            if "light" in found and "any" not in found:
                found["any"] = found.pop("light")
            if "any" in found:
                colors[colorset.stem] = found
    return colors


def _uicolor(spec):
    if spec[0] == "system":
        return (f'((UIColor.self as AnyObject).perform(NSSelectorFromString({swift_string(spec[1])}))?'
                f'.takeUnretainedValue() as? UIColor ?? .clear)')
    kind, r, g, b, a = spec
    if kind == "display-p3":
        return f"UIColor(displayP3Red: {r:.4f}, green: {g:.4f}, blue: {b:.4f}, alpha: {a:.4f})"
    return f"UIColor(red: {r:.4f}, green: {g:.4f}, blue: {b:.4f}, alpha: {a:.4f})"


def swift_string(text):
    """A Swift string literal for text (JSON's \\u00fc escapes are not Swift: asset names like "Mensa Brühl")."""
    out = []
    for ch in text:
        if ch in '"\\':
            out.append("\\" + ch)
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\t":
            out.append("\\t")
        elif ch == "\r":
            out.append("\\r")
        elif ord(ch) < 0x20 or ord(ch) == 0x7F:
            out.append(f"\\u{{{ord(ch):x}}}")
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def colors_source(colors):
    """Swift code standing in for the colour sets that only an asset catalog compiler could provide."""
    cases = []
    for name, looks in sorted(colors.items()):
        value = _uicolor(looks["any"])
        if "dark" in looks:
            value = (f"UIColor {{ $0.userInterfaceStyle == .dark ? {_uicolor(looks['dark'])} : {value} }}")
        cases.append(f"    case {swift_string(name)}: return {value}")
    return ("\n// Colour sets from the asset catalogs (Assets.car cannot be compiled without a Mac).\n"
            "func __peekUIColor(_ name: String) -> UIColor? {\n    switch name {\n" + "\n".join(cases)
            + "\n    default: return nil\n    }\n}\n\n"
            "func __peekColor(_ name: String) -> SwiftUI.Color {\n"
            "    SwiftUI.Color(uiColor: __peekUIColor(name) ?? .clear)\n}\n")


TESTED_IMPORT_RE = re.compile(r"^[ \t]*(@testable[ \t]+)?import[ \t]+(\w+)[ \t]*$", re.M)

SWIFT_KEYWORDS = set("""associatedtype class deinit enum extension fileprivate func import init inout internal let
open operator private precedencegroup protocol public rethrows static struct subscript typealias var break case
catch continue default defer do else fallthrough for guard if in repeat return throw switch where while as false is
nil self super throws true try Any Self Type""".split())

# Static members SwiftUI and UIKit already have; Xcode leaves these out of the Color/UIColor shortcuts too.
SYSTEM_COLOR_NAMES = set("""red orange yellow green mint teal cyan blue indigo purple pink brown white gray black clear
primary secondary tertiary quaternary quinary accentColor tint foreground background separator selection placeholder
link fill label darkGray lightGray magenta""".split())


def asset_symbol(name, suffix):
    """The Swift name Xcode's asset symbol generation gives an asset ("brand-primary" → brandPrimary,
    "AccentColor" → accent, "URLIcon" → urlIcon)."""
    words = [w for w in re.split(r"[^0-9A-Za-z]+", name) if w]
    if not words:
        return None
    if len(words[-1]) > len(suffix) and words[-1].endswith(suffix):
        words[-1] = words[-1][:-len(suffix)]
    elif len(words) > 1 and words[-1].lower() == suffix.lower():
        words.pop()
    first = words[0]
    lead = re.match(r"[A-Z]+(?=[A-Z][a-z]|[0-9]|$)|[A-Z]", first)
    first = first[:lead.end()].lower() + first[lead.end():] if lead else first
    symbol = first + "".join(w[:1].upper() + w[1:] for w in words[1:])
    if symbol[0].isdigit():
        symbol = "_" + symbol
    return f"`{symbol}`" if symbol in SWIFT_KEYWORDS else symbol


def asset_symbols_source(colors, images, has_bundle):
    """Stand-ins for the asset symbols Xcode generates (`Color(.brand)`, `.foregroundStyle(.brand)`,
    `Image(.logo)`, `UIImage(resource: .logo)`). The SDK's own initialisers look the resource up in a
    compiled Assets.car, which peek cannot build, so this module's versions (which win over the SDK's)
    use the colours and loose images peek ships instead."""
    def table(names, suffix):
        out, seen = {}, set()
        for name in sorted(names):
            symbol = asset_symbol(name, suffix)
            if symbol and symbol not in seen:
                seen.add(symbol)
                out[name] = symbol
        return out
    color_symbols, image_symbols = table(colors, "Color"), table(images if has_bundle else (), "Image")
    if not color_symbols and not image_symbols:
        return ""
    bundle = "Foundation.Bundle.module" if has_bundle else "Foundation.Bundle.main"
    lines = ["\n// Asset symbols (Xcode generates these from the asset catalogs).",
             "@available(iOS 17.0, *) extension DeveloperToolsSupport.ColorResource {"]
    lines += [f"    static let {s} = DeveloperToolsSupport.ColorResource(name: {swift_string(n)}, bundle: {bundle})"
              for n, s in color_symbols.items()]
    lines += ["}", "@available(iOS 17.0, *) extension DeveloperToolsSupport.ImageResource {"]
    lines += [f"    static let {s} = DeveloperToolsSupport.ImageResource(name: {swift_string(n)}, bundle: {bundle})"
              for n, s in image_symbols.items()]
    lines += ["}",
              "@available(iOS 17.0, *) let __peekColorNames: [DeveloperToolsSupport.ColorResource: String] = "
              f"Dictionary(uniqueKeysWithValues: [{', '.join(swift_string(x) for x in color_symbols)}].map "
              f"{{ (DeveloperToolsSupport.ColorResource(name: $0, bundle: {bundle}), $0) }})",
              "@available(iOS 17.0, *) let __peekImageNames: [DeveloperToolsSupport.ImageResource: String] = "
              f"Dictionary(uniqueKeysWithValues: [{', '.join(swift_string(x) for x in image_symbols)}].map "
              f"{{ (DeveloperToolsSupport.ImageResource(name: $0, bundle: {bundle}), $0) }})",
              "@available(iOS 17.0, *) extension SwiftUI.Color {",
              "    init(_ resource: DeveloperToolsSupport.ColorResource) {",
              '        self = __peekColor(__peekColorNames[resource] ?? "")',
              "    }",
              "}",
              "@available(iOS 17.0, *) extension UIKit.UIColor {",
              "    convenience init(resource: DeveloperToolsSupport.ColorResource) {",
              '        let name = __peekColorNames[resource] ?? ""',
              "        self.init { traits in __peekUIColor(name)?.resolvedColor(with: traits) ?? .clear }",
              "    }",
              "}",
              "@available(iOS 17.0, *) extension SwiftUI.Image {",
              "    init(_ resource: DeveloperToolsSupport.ImageResource) {",
              '        self = __peekImage(__peekImageNames[resource] ?? "")',
              "    }",
              "}",
              "@available(iOS 17.0, *) extension UIKit.UIImage {",
              "    convenience init(resource: DeveloperToolsSupport.ImageResource) {",
              f'        if let name = __peekImageNames[resource], UIImage(named: name, in: {bundle}, with: nil) != nil {{',
              f"            self.init(named: name, in: {bundle}, with: nil)!",
              "        } else {",
              "            self.init()",
              "        }",
              "    }",
              "}"]
    shortcuts = {n: s for n, s in color_symbols.items() if s.strip("`") not in SYSTEM_COLOR_NAMES}
    if shortcuts:
        lines.append("extension SwiftUI.Color {")
        lines += [f"    static var {s}: SwiftUI.Color {{ __peekColor({swift_string(n)}) }}" for n, s in shortcuts.items()]
        # Disfavoured so that `Color(.name)` picks the ColorResource in patches (another module) too.
        lines += ["}", "extension SwiftUI.ShapeStyle where Self == SwiftUI.Color {"]
        lines += [f"    @_disfavoredOverload static var {s}: SwiftUI.Color {{ __peekColor({swift_string(n)}) }}"
                  for n, s in shortcuts.items()]
        lines += ["}", "extension UIKit.UIColor {"]
        lines += [f"    static var {s}: UIKit.UIColor {{ __peekUIColor({swift_string(n)}) ?? .clear }}"
                  for n, s in shortcuts.items()]
        lines.append("}")
    if image_symbols:
        lines.append("extension UIKit.UIImage {")
        lines += [f"    static var {s}: UIKit.UIImage {{ UIImage(named: {swift_string(n)}, in: {bundle}, with: nil) ?? UIImage() }}"
                  for n, s in image_symbols.items()]
        lines.append("}")
    return "\n".join(lines) + "\n"


_STR = r'"((?:[^"\\\n]|\\.)*)"'
_ARG = r"[^()\n]*?(?:\([^()\n]*\))?"
ASSET_CALLS = [
    ("color", re.compile(rf"\b(?:SwiftUI\.)?Color\([ \t]*{_STR}[ \t]*(?:,[ \t]*bundle:{_ARG}[ \t]*)?\)"), '__peekColor("{}")'),
    ("color", re.compile(rf"\bUIColor\([ \t]*named:[ \t]*{_STR}[ \t]*(?:,[ \t]*in:{_ARG},[ \t]*compatibleWith:{_ARG}[ \t]*)?\)"),
     '__peekUIColor("{}")'),
    ("image", re.compile(rf"\b(?:SwiftUI\.)?Image\([ \t]*{_STR}[ \t]*"
                         r"(?:,[ \t]*bundle:[ \t]*(?:\.module|(?:Foundation\.)?Bundle\.module)[ \t]*)?\)"), '__peekImage("{}")'),
    ("image", re.compile(rf"\bUIImage\([ \t]*named:[ \t]*{_STR}[ \t]*\)"), 'UIImage(named: "{}", in: .module, with: nil)'),
]


SYMBOL_CALLS = [
    ("color", re.compile(r"\b(?:SwiftUI\.)?Color\([ \t]*\.([A-Za-z_][A-Za-z0-9_]*)[ \t]*\)"), '__peekColor("{}")'),
    ("color", re.compile(r"\bUIColor\([ \t]*resource:[ \t]*\.([A-Za-z_][A-Za-z0-9_]*)[ \t]*\)"),
     '(__peekUIColor("{}") ?? .clear)'),
    ("image", re.compile(r"\b(?:SwiftUI\.)?Image\([ \t]*\.([A-Za-z_][A-Za-z0-9_]*)[ \t]*\)"),
     '__peekImage("{}")'),
    ("image", re.compile(r"\bUIImage\([ \t]*resource:[ \t]*\.([A-Za-z_][A-Za-z0-9_]*)[ \t]*\)"),
     '(UIImage(named: "{}", in: .module, with: nil) ?? UIImage())'),
]


def use_assets(src, images, colors):
    """Points asset lookups by name at what peek ships instead of a compiled asset catalog."""
    mask = code_mask(src)
    edits = []
    for kind, pattern, template in ASSET_CALLS:
        names = colors if kind == "color" else images
        for m in pattern.finditer(src):
            name = m.group(m.lastindex)
            if name not in names or mask[m.start()] == " ":
                continue  # unknown name, or inside a comment or string
            edits.append((m.start(), m.end(), template.format(name)))
    # Asset symbols: rewritten too, because in a hot patch (another module) the SDK's initialisers
    # and the ones in __PeekSupport.swift are ambiguous.
    for kind, pattern, template in SYMBOL_CALLS:
        names = colors if kind == "color" else images
        symbols = {asset_symbol(n, "Color" if kind == "color" else "Image"): n for n in sorted(names, reverse=True)}
        if kind == "color":  # Color(.red) also means Color(UIColor.red); leave it to the compiler
            symbols = {k: v for k, v in symbols.items() if k and k.strip("`") not in SYSTEM_COLOR_NAMES}
        for m in pattern.finditer(src):
            name = symbols.get(m.group(1))
            if name is None or mask[m.start()] == " ":
                continue
            edits.append((m.start(), m.end(), template.format(name)))
    for start, end, text in sorted(edits, reverse=True):
        src = src[:start] + text + src[end:]
    return src


def _strings_literal(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'


def string_catalog_files(catalog, out):
    """.strings and .stringsdict files for a string catalog (.xcstrings), which only Xcode compiles.

    Writes <out>/<lang>.lproj/<Table>.strings(dict) and yields (path inside the bundle, file).
    Plural variations become .stringsdict entries; device variations use the iPhone form."""
    try:
        data = json.loads(Path(catalog).read_text())
    except (OSError, ValueError):
        return
    table, source = Path(catalog).stem, data.get("sourceLanguage", "en")
    plain, plurals = {}, {}  # lang -> {key: value}, lang -> {key: {category: value}}
    for key, entry in (data.get("strings") or {}).items():
        if entry.get("shouldTranslate") is False and not entry.get("localizations"):
            continue
        localizations = dict(entry.get("localizations") or {})
        localizations.setdefault(source, {"stringUnit": {"value": key}})
        for lang, loc in localizations.items():
            unit = loc.get("stringUnit")
            variations = loc.get("variations") or {}
            if "device" in variations:
                device = variations["device"]
                pick = device.get("iphone") or device.get("other") or next(iter(device.values()), {})
                unit, variations = pick.get("stringUnit"), pick.get("variations") or {}
            if "plural" in variations:
                forms = {cat: v.get("stringUnit", {}).get("value", "") for cat, v in variations["plural"].items()}
                plurals.setdefault(lang, {})[key] = forms
            elif unit and unit.get("value") is not None:
                plain.setdefault(lang, {})[key] = unit["value"]
    for lang in sorted(set(plain) | set(plurals)):
        folder = Path(out) / f"{lang}.lproj"
        folder.mkdir(parents=True, exist_ok=True)
        if lang in plain:
            path = folder / f"{table}.strings"
            write_if_changed(path, "".join(f"{_strings_literal(k)} = {_strings_literal(v)};\n"
                                           for k, v in sorted(plain[lang].items())))
            yield f"{lang}.lproj/{table}.strings", path
        if lang in plurals:
            entries = {}
            for key, forms in plurals[lang].items():
                spec = re.search(r"%(?:\d+\$)?(?:l{0,2}|h{0,2}|z|t|j|q)?[dDuUioOxXcCfFeEgGaAsS@]", forms.get("other", key))
                entries[key] = {"NSStringLocalizedFormatKey": "%#@value@",
                                "value": {"NSStringFormatSpecTypeKey": "NSStringPluralRuleType",
                                          "NSStringFormatValueTypeKey": spec.group(0)[1:].lstrip("0123456789$") if spec else "lld",
                                          **forms}}
            path = folder / f"{table}.stringsdict"
            data_ = plistlib.dumps(entries)
            if not path.exists() or path.read_bytes() != data_:
                path.write_bytes(data_)
            yield f"{lang}.lproj/{table}.stringsdict", path


def flatten_asset_catalog(catalog):
    """Loose files for the image sets of an .xcassets folder (compiling Assets.car needs a Mac).

    `Image("name", bundle: .module)` finds loose `name.png` / `name@2x.png` files. Colour sets
    and other asset types have no loose-file equivalent and are skipped.
    """
    for imageset in sorted(catalog.rglob("*.imageset")):
        try:
            images = json.loads((imageset / "Contents.json").read_text()).get("images", [])
        except (OSError, ValueError):
            images = []
        for image in images:
            filename = image.get("filename")
            if not filename or image.get("appearances") or not (imageset / filename).exists():
                continue
            scale = image.get("scale", "1x")
            suffix = "" if scale == "1x" else f"@{scale}"
            yield f"{imageset.stem}{suffix}{Path(filename).suffix}", imageset / filename


# ------------------------------------------------------------------ builder

class Builder:
    def __init__(self, args, toolchain):
        self.tc = toolchain
        target = Path(args.path).resolve()
        if not target.exists():
            sys.exit(f"peek: {target} does not exist")
        self.single = target if target.is_file() else None
        self.root = target.parent if self.single else target
        self.root_expr = args.root
        self.prefer_app = getattr(args, "app", False)
        self.wanted_target = getattr(args, "target", None)
        self.ios_override = args.ios
        self.swift_version = args.swift_version
        self.extra = args.swiftc_flag or []
        self.incremental = not getattr(args, "no_incremental", False)
        # Hot patching keeps view state across edits that only change function bodies.
        self.tests = getattr(args, "tests", False)  # run the test targets on the phone instead of previews
        self.test_filter = getattr(args, "filter", None)  # regular expression on "Suite/test" names
        self.junit = getattr(args, "junit", None)  # file for the results as JUnit XML
        if self.tests:
            # Earlier builds stay loaded and Swift Testing finds tests in every loaded image, so
            # each build gets a module of its own and the runner only runs that module's tests.
            self.incremental = False
        self.hot = self.incremental and not getattr(args, "no_hot", False) and not self.tests
        self.base = None  # the last full build, which patches apply to
        self.force_full = False
        self.patch_error = None
        self.session = os.urandom(3).hex()  # build file names must not repeat while the app runs
        key = hashlib.sha1(str(target).encode()).hexdigest()[:12]
        self.out = STATE_DIR / "build" / key
        self.scratch = STATE_DIR / "spm" / key  # kept between runs: dependency builds are slow
        # Sources and objects are kept between runs too, so the first build after a restart is incremental.
        for old in self.out.glob("*.dylib"):
            old.unlink()
        if not self.incremental:
            shutil.rmtree(self.out / "obj", ignore_errors=True)
        (self.out / "src").mkdir(parents=True, exist_ok=True)
        self.name = target.stem if self.single else target.name
        self.is_package = not self.single and (self.root / "Package.swift").exists()
        self.package = None
        self.package_error = None
        self.colors, self.images = {}, set()
        self.display_names = {}
        self.uses_xctest = self.uses_ui_tests = False

    @property
    def ios(self):
        """The deployment target builds are compiled for: the project's, but at least iOS 17, which
        the Peek app needs anyway (peek's own support code uses iOS 17 API)."""
        version = self.ios_override
        manifest = self.root / "Package.swift"
        if not version and self.is_package and manifest.exists():
            m = re.search(r"\.iOS\(\s*(?:\.v(\d+)(?:_(\d+))?|\"([\d.]+)\")", manifest.read_text(errors="replace"))
            if m:
                version = m.group(3) or f"{m.group(1)}.{m.group(2) or 0}"
        parts = tuple(int(p) for p in re.findall(r"\d+", version or "")[:3])
        return version if parts >= MIN_IOS else ".".join(map(str, MIN_IOS))

    # -- inputs

    def source_dir(self):
        if self.package:
            return self.package.target_dir
        return self.root / "Sources" if (self.root / "Sources").is_dir() else self.root

    def sources(self):
        if self.single:
            return [self.single]
        found = [p for p in walk_files(self.source_dir()) if p.suffix == ".swift" and p.name != "Package.swift"]
        return found + [p for p in self.test_sources() if p not in found]

    def test_dirs(self):
        if not self.tests:
            return []
        if self.package:
            return self.package.test_dirs
        return [self.root / "Tests"] if (self.root / "Tests").is_dir() else []

    def test_sources(self):
        return [p for d in self.test_dirs() for p in sorted(d.rglob("*.swift"))
                if not any(part in SKIP_DIRS - {"Tests"} or part.startswith(".") for part in p.relative_to(d).parts)]

    def resources(self):
        """Returns (bundle name for Bundle.module or None, [(path inside the archive, file)])."""
        files, name = [], None
        if self.package:
            name = self.package.bundle_name
            for bundle in self.package.bundles():  # the dependencies' bundles, built by SwiftPM
                if bundle.stem == name:
                    continue  # left by an older peek; the previewed target's bundle is made here
                for path in walk_files(bundle):
                    files.append((f"{bundle.name}/{path.relative_to(bundle)}", path))
            # The previewed target's own resources, laid out the way SwiftPM's bundle has them.
            for path, rule in self.package.resources:
                if path.suffix == ".xcassets":
                    continue  # flattened below
                if path.suffix == ".xcstrings":
                    files += [(f"{name}.bundle/{a}", f) for a, f in self._string_catalog(path)]
                    continue
                if path.is_dir():
                    for inner in walk_files(path):
                        files.append((f"{name}.bundle/{path.name}/{inner.relative_to(path)}", inner))
                elif rule == "process" and path.parent.suffix == ".lproj":
                    files.append((f"{name}.bundle/{path.parent.name}/{path.name}", path))
                else:
                    files.append((f"{name}.bundle/{path.name}", path))
            catalogs = sorted(self.package.target_dir.rglob("*.xcassets"))
            if catalogs:
                name = name or f"{self.package.name}_{self.package.target}"
            if name:  # SwiftPM's bundles have one too; it tells Foundation the development language
                info = self.out / "bundle-Info.plist"
                data = plistlib.dumps({"CFBundleIdentifier": f"{self.package.name}.{self.package.target}.resources",
                                       "CFBundleDevelopmentRegion": self.package.default_localization or "en"})
                if not info.exists() or info.read_bytes() != data:
                    info.write_bytes(data)
                files.append((f"{name}.bundle/Info.plist", info))
        elif not self.single:
            name = "PeekResources"
            base = self.source_dir()
            for folder in sorted(p for p in base.rglob("Resources") if p.is_dir()):
                for path in walk_files(folder, skip=lambda p: any(part.endswith(".xcassets") for part in p.parts)):
                    if path.suffix != ".xcstrings":
                        files.append((f"{name}.bundle/{path.name}", path))
            for catalog in [p for p in walk_files(base) if p.suffix == ".xcstrings"]:
                files += [(f"{name}.bundle/{a}", f) for a, f in self._string_catalog(catalog)]
            catalogs = sorted(base.rglob("*.xcassets"))
        else:
            catalogs = []
        for catalog in catalogs:
            for filename, path in flatten_asset_catalog(catalog):
                files.append((f"{name}.bundle/{filename}", path))
        self.colors = asset_colors(catalogs)
        unique = {}
        for arcname, path in files:
            unique.setdefault(arcname, path)
        if not unique and not (self.package and self.package.bundle_name):
            name = None
        # Image names that `Image("name")` should find in that bundle.
        self.images = {re.sub(r"@\dx$", "", Path(a).stem) for a in unique
                       if name and a.startswith(f"{name}.bundle/") and a.count("/") == 1
                       and Path(a).suffix.lower() in (".png", ".jpg", ".jpeg", ".pdf", ".heic", ".gif")}
        return name, sorted(unique.items())

    def _string_catalog(self, catalog):
        out = self.out / "strings" / hashlib.sha1(str(catalog).encode()).hexdigest()[:8]
        return list(string_catalog_files(catalog, out))

    @staticmethod
    def _stamp(paths):
        parts = []
        for p in paths:
            try:
                st = p.stat()
                parts.append((str(p), st.st_mtime_ns, st.st_size))
            except OSError:
                pass
        return tuple(parts)

    def fingerprint(self):
        """Changes whenever a fast rebuild is needed."""
        if self.is_package and not self.package:
            return self._stamp(self.sources())
        return self._stamp(self.sources()) + self._stamp(p for _, p in self.resources()[1])

    def package_fingerprint(self):
        """Changes whenever the dependencies must be rebuilt by SwiftPM (package mode only)."""
        if not self.is_package:
            return None
        target_dir = self.package.target_dir if self.package else None
        roots = [self.root] + [d for d in (self.package.local_deps if self.package else [])
                               if self.root not in d.parents]

        own = [target_dir] + (self.package.test_dirs if self.package else []) if target_dir else []

        def previewed_source(path):  # the previewed target's (and its tests') files: peek builds those itself
            return any(d in path.parents for d in own) and path.name != "Package.swift"

        return self._stamp(p for base in roots for p in walk_files(base, skip=previewed_source))

    # -- building

    def prepare_package(self, changed=None):
        """Resolves and builds the package's dependencies. Slow; runs when the manifest or a dependency changes.

        When only dependency sources changed, the manifest is not read again and only the
        dependencies are rebuilt."""
        self.package_error = None
        if self.package and changed and self.package.only_dependency_sources(changed):
            ok, output = self.package.build(dependencies_only=True)
            if not ok:
                self.package_error = "building the dependencies failed:\n" + output
            return ok
        try:
            self.package = Package(self.root, self.tc, self.wanted_target, self.scratch, tests=self.tests)
        except (ValueError, OSError) as e:
            self.package, self.package_error = None, f"Package.swift: {e}"
            return False
        ok, output = self.package.build()
        if not ok:
            self.package_error = "building the dependencies failed:\n" + output
        return ok

    @staticmethod
    def target_bundle_identifier():
        """The bundle identifier iOS knows the app hosting Peek by (reported by the phone)."""
        try:
            return (STATE_DIR / "identifier").read_text().strip()
        except OSError:
            return ""

    def shipped_frameworks(self):
        """Dynamic frameworks (and libraries) the phone needs next to the builds."""
        found = self.package.dynamic_frameworks() if self.package else []
        if self.tests:
            found = found + [self.tc.developer / "Library/Frameworks/Testing.framework",
                             self.tc.developer / "usr/lib/lib_TestingInterop.dylib"]
        if self.tests and self.uses_xctest:
            dev = self.tc.developer
            found = found + [dev / "Library/Frameworks/XCTest.framework", dev / "Library/Frameworks/XCUIAutomation.framework",
                             dev / "Library/Frameworks/_Testing_Foundation.framework",
                             dev / "Library/PrivateFrameworks/XCTestCore.framework",
                             dev / "Library/PrivateFrameworks/XCTAutomationSupport.framework",
                             dev / "Library/PrivateFrameworks/XCTestSupport.framework",
                             dev / "usr/lib/libXCTestSwiftSupport.dylib"]
        return found

    def _common_flags(self):
        cmd = ["-target", f"arm64-apple-ios{self.ios}", "-sdk", str(self.tc.sdk), "-resource-dir", str(self.tc.resources)]
        if self.package:
            products = self.package.products
            cmd += ["-I", str(products), "-F", str(products / "PackageFrameworks"), "-F", str(products)]
            if (products / "include").is_dir():  # headers and module maps of binary targets
                cmd += ["-I", str(products / "include")]
            cmd += ["-F", str(self.package.staged)]
            for headers in self.package.header_paths():
                cmd += ["-I", str(headers)]
        if self.tests:  # Testing and XCTest ship with the SDK, outside the SDK root
            dev = self.tc.developer
            cmd += ["-F", str(dev / "Library/Frameworks"), "-F", str(dev / "Library/PrivateFrameworks"),
                    "-I", str(dev / "usr/lib"), "-L", str(dev / "usr/lib")]
        return cmd

    def _link_flags(self):
        cmd = ["-Xclang-linker", "-mlinker-version=1100"]
        if self.tc.linker:
            cmd.append(f"-ld-path={self.tc.linker}")
        if self.tc.runtime:  # provides __isPlatformVersionAtLeast for `if #available`
            cmd += ["-Xlinker", str(self.tc.runtime)]
        if self.package and self.package.frameworks():
            cmd += [a for f in self.package.frameworks() for a in ("-framework", f.stem)]
        if self.tests:
            cmd += ["-framework", "Testing"]
        if self.tests and self.uses_xctest:
            cmd += ["-framework", "XCTest", "-lXCTestSwiftSupport"]
        if self.shipped_frameworks():
            # The phone puts dynamic frameworks in Frameworks/ next to the builds.
            cmd += ["-Xlinker", "-rpath", "-Xlinker", "@loader_path/Frameworks"]
        return cmd + (self.package.link_flags if self.package else [])

    @staticmethod
    def _clean(output, replacements=()):
        output = "\n".join(l for l in output.splitlines()
                           if "does not support linking for platform" not in l
                           and "auto-linked framework not found" not in l
                           and "search path" not in l)
        for old, new in replacements:
            output = output.replace(old, new)
        return output

    def deps_library(self, sign_key):
        """Links the package's dependencies into one library the phone keeps across reloads.

        Its name holds a hash of the objects and of the signing identity, so the phone downloads
        it again only when either changes. Returns (id, path) or None.
        """
        objects = self.package.objects() if self.package else []
        if not objects:
            return None
        frameworks = self.package.frameworks()
        # Test builds link Testing and XCTest into it too, which a preview of the same project
        # must not inherit (the phone only has them while tests run).
        linked = (self.tests, self.uses_xctest)
        key = hashlib.sha1(repr((self._stamp(objects), self._stamp(frameworks), sign_key, self.ios, linked)).encode()).hexdigest()[:12]
        folder = self.out / "deps"
        path = folder / f"PeekDeps-{key}.dylib"
        if not path.exists():
            folder.mkdir(exist_ok=True)
            for old in folder.glob("PeekDeps-*"):
                old.unlink()
            members = folder / "objects"
            shutil.rmtree(members, ignore_errors=True)
            members.mkdir()
            inputs = [f for o in objects for f in unpack_object(o, members)]
            # libc++ for C++ in any dependency, remote packages included (their sources are not listed).
            cmd = [self.tc.swiftc, "-emit-library", *self._common_flags(), *self._link_flags(), "-lc++",
                   "-Xlinker", "-install_name", "-Xlinker", f"@loader_path/{path.name}",
                   *map(str, inputs), "-o", str(path)]
            proc = subprocess.run(cmd, capture_output=True, text=True, cwd=self.out)
            if proc.returncode != 0 or not path.exists():
                raise RuntimeError("linking the dependencies failed:\n" + self._clean(proc.stdout + proc.stderr))
        return key, path

    def build(self, version, sign_key=""):
        """Compile the sources into <out>/peek_<version>.dylib. Returns a result dict.

        Compilation is incremental: rewritten copies of the sources are only rewritten when their
        content changes, and the module name stays the same, so swiftc recompiles just the files
        affected by an edit. Each version is then linked into a library of its own.
        """
        started = time.time()
        if self.is_package and (not self.package or self.package_error):
            # A failed dependency build leaves the previous objects behind; building on them
            # would show a preview of code that no longer exists.
            return {"ok": False, "diagnostics": self.package_error or "Package.swift could not be read"}
        sources = self.sources()
        if not sources:
            return {"ok": False, "diagnostics": f"No .swift files found in {self.source_dir()}"}
        srcdir, objdir = self.out / "src", self.out / "obj"
        srcdir.mkdir(parents=True, exist_ok=True)
        objdir.mkdir(exist_ok=True)
        roots, inputs, structs, app = [], [], [], None
        bundle_name, resources = self.resources()
        texts = {path: path.read_text(errors="replace") for path in sources}
        keep_shape = synthesized_elsewhere(texts.values())
        # A project that keeps Xcode's generated asset symbols in its sources brings its own.
        own_symbols = any(re.search(r"extension\s+(?:DeveloperToolsSupport\.)?(?:Color|Image)Resource\b", t)
                          for t in texts.values())
        test_files = set(self.test_sources())
        if self.tests and not test_files:
            return {"ok": False, "diagnostics": "No tests found (peek test looks in the test targets of the "
                                                "package, or in Tests/ next to Sources/)."}
        self.uses_xctest = any(re.search(r"^[ \t]*(?:@testable[ \t]+)?import[ \t]+XCTest\b", texts[p], re.M)
                               for p in test_files)
        self.uses_ui_tests = self.uses_xctest and any(re.search(r"\bXCUI(?:Application|Device|Element)\b", code_mask(texts[p]))
                                                      for p in test_files)
        tested = {self.package.target, re.sub(r"\W", "_", self.package.target)} if self.package else set()
        for path in sources:
            shown = path.name if self.single else os.path.relpath(path, self.root)  # sources may sit outside it (a linked folder)
            tag = hashlib.sha1(shown.encode()).hexdigest()[:8]
            text = texts[path]
            if path in test_files:
                # Tests are compiled into the same module as the code they test.
                text = TESTED_IMPORT_RE.sub(lambda m: _blank(m.group(0)) if m.group(2) in tested
                                            or (m.group(1) and not self.package) else m.group(0), text)
            new, found, app_struct = rewrite_source(text, tag, keep_shape)
            new = use_assets(new, self.images if bundle_name else set(), self.colors)
            roots += found
            app = app or app_struct
            structs += VIEW_STRUCT_RE.findall(code_mask(text))
            copy = srcdir / f"{tag}_{path.name}"
            write_if_changed(copy, new)
            inputs.append((copy, shown))
        if self.tests and not self.uses_ui_tests:
            cases = [("__PeekTestRunner()", "Tests")]
        elif self.root_expr:
            cases = [(self.root_expr, self.root_expr)]
        elif roots and not self.prefer_app:
            cases = [(f"{name}()", title or f"Preview {n + 1}") for n, (name, title) in enumerate(roots)]
        elif app:
            cases = [(f"{app}()", "App")]
        else:
            pick = "ContentView" if "ContentView" in structs else (structs[0] if structs else None)
            if not pick:
                return {"ok": False, "diagnostics":
                        "No #Preview block, @main App or View struct found.\n"
                        "Add `#Preview { MyView() }` or pass --root \"MyView()\"."}
            cases = [(f"{pick}()", pick)]
        if self.tests and self.uses_ui_tests:  # UI tests drive the app the previews would show
            cases = [(f"__PeekTestRunner(app: AnyView({cases[0][0]}))", "UI tests")]
        body = "\n".join(
            f"        case {i}: return UIHostingController(rootView: AnyView(__PeekGenerationRoot(content: AnyView({expr}))))"
            for i, (expr, _) in enumerate(cases))
        support, entry = srcdir / "__PeekSupport.swift", srcdir / "__PeekEntry.swift"
        write_if_changed(support, SUPPORT_SOURCE + (BUNDLE_TEMPLATE.replace("%NAME%", bundle_name) if bundle_name else "")
                         + colors_source(self.colors)
                         + ("" if own_symbols else asset_symbols_source(self.colors, self.images, bool(bundle_name)))
                         + (TEST_RUNNER_SOURCE.replace("%FILTER%", swift_string(self.test_filter or ""))
                            .replace("%XCTEST%", XCTEST_RUNNER.replace("%UITESTS%", "true" if self.uses_ui_tests else "false")
                                                    .replace("%TARGETBUNDLE%", swift_string(self.target_bundle_identifier()))
                                                    if self.uses_xctest else XCTEST_NONE)
                            if self.tests else ""))
        write_if_changed(entry, ENTRY_TEMPLATE.replace("%CASES%", body))
        files = [c for c, _ in inputs] + [support, entry]
        for stale in srcdir.glob("*.swift"):
            if stale not in files:
                stale.unlink()
        shown = [(str(c), s) for c, s in inputs] + [(str(srcdir) + "/", "")]
        self.display_names = {c.name: s for c, s in inputs}  # for file names in the phone's output
        language = self.swift_version or (self.package.language_mode if self.package else None) or "5"
        snapshot = {f.name: f.read_text() for f in files}
        resources_key = repr(self._stamp(p for _, p in resources)) + repr([a for a, _ in resources])
        roots = [title for _, title in cases]
        try:
            deps = self.deps_library(sign_key)
        except (RuntimeError, ValueError, OSError) as e:
            return {"ok": False, "diagnostics": str(e), "seconds": time.time() - started}

        if self.hot and self.base and not self.force_full:
            patch = self._patch(version, snapshot, deps, resources_key, language, shown)
            if patch and patch.get("noop"):
                return patch
            if patch:
                patch.update(roots=self.base["roots"], resources=resources, deps=deps,
                             frameworks=self.shipped_frameworks(),
                             seconds=time.time() - started)
                return patch

        output_map = {"": {"swift-dependencies": str(objdir / "module.swiftdeps")}}
        for f in files:
            output_map[str(f)] = {"object": str(objdir / f"{f.stem}.o"),
                                  "swift-dependencies": str(objdir / f"{f.stem}.swiftdeps")}
        write_if_changed(self.out / "output-file-map.json", json.dumps(output_map, indent=1))
        module = "PeekPreview" if self.incremental else f"PeekBuild_{self.session}_{version}"  # unique per server run too: old builds stay loaded
        if not self.incremental:
            for old in objdir.glob("*"):
                old.unlink()
        cmd = [self.tc.swiftc, "-c", "-parse-as-library", "-Onone", "-module-name", module,
               "-swift-version", language, *self._common_flags(),
               "-Xfrontend", "-enable-cross-import-overlays",
               "-D", "DEBUG", "-D", "PEEK", "-suppress-warnings",
               "-j", str(os.cpu_count() or 2), "-output-file-map", str(self.out / "output-file-map.json")]
        if self.incremental:
            cmd.append("-incremental")
        if self.hot:
            (self.out / "module").mkdir(exist_ok=True)
            cmd += HOT_FLAGS + ["-emit-module", "-emit-module-path", str(self.out / "module/PeekPreview.swiftmodule")]
        cmd += self._package_flags() + self.extra + [str(f) for f in files]
        proc = subprocess.run(cmd, capture_output=True, text=True, cwd=self.out)
        output = self._clean(proc.stdout + proc.stderr, shown)
        objects = [objdir / f"{f.stem}.o" for f in files]
        name = f"peek_{self.session}_{version}.dylib"
        dylib = self.out / name
        if proc.returncode == 0:
            link = [self.tc.swiftc, "-emit-library", *self._common_flags(), *self._link_flags(),
                    "-Xlinker", "-install_name", "-Xlinker", f"@loader_path/{name}",
                    *map(str, objects), *([str(deps[1])] if deps else []), "-o", str(dylib)]
            proc = subprocess.run(link, capture_output=True, text=True, cwd=self.out)
            output = (output + "\n" + self._clean(proc.stdout + proc.stderr, shown)).strip()
        elapsed = time.time() - started
        if proc.returncode != 0 or not dylib.exists():
            return {"ok": False, "diagnostics": output.strip() or "swiftc failed", "seconds": elapsed}
        self.base = {"version": version, "file": name, "snapshot": snapshot, "roots": roots,
                     "deps": deps[0] if deps else None, "resources": resources_key} if self.hot else None
        self._clean_old_builds(keep={dylib})
        return {"ok": True, "dylib": dylib, "file": name, "roots": roots, "seconds": elapsed,
                "resources": resources, "deps": deps, "frameworks": self.shipped_frameworks()}

    def _package_flags(self):
        if not self.package:
            return []
        return ["-package-name", self.package.identity, *self.package.swift_flags, *self.package.macro_plugins(),
                *self.package.module_maps()]

    def _clean_old_builds(self, keep):
        keep = set(keep) | ({self.out / self.base["file"]} if self.base else set())
        for old in self.out.glob("peek_*.dylib"):
            if old not in keep and old.with_name(old.name.replace(".signed", "")) not in keep \
                    and old.stat().st_mtime < time.time() - 600:
                old.unlink()

    def _patch(self, version, snapshot, deps, resources_key, language, shown):
        """A patch library on top of the last full build, or None when this edit needs a full build."""
        base = self.base
        if (set(snapshot) != set(base["snapshot"]) or (deps[0] if deps else None) != base["deps"]
                or resources_key != base["resources"]):
            return None
        patched = base.setdefault("patched", {})  # file -> member indexes some patch replaced
        changed = [f for f in snapshot if snapshot[f] != base["snapshot"][f] or patched.get(f)]
        if not changed or any(f.startswith("__Peek") for f in changed):
            return None
        sources, replaced = [], {}
        for f in changed:
            made = patch_sources(base["snapshot"][f], snapshot[f], f, version, patched.get(f, ()))
            if made is None:
                return None
            if made[1]:
                sources.append(made[0])
                replaced[f] = made[2]
        if not sources:
            return {"ok": True, "noop": True}  # only comments or formatting changed
        folder = self.out / "patch"
        shutil.rmtree(folder, ignore_errors=True)
        folder.mkdir()
        thunks = []
        for i, text in enumerate(sources):
            thunks.append(folder / f"thunk_{i}.swift")
            thunks[-1].write_text(text)
        name = f"peek_{self.session}_{version}.dylib"
        dylib = self.out / name
        cmd = [self.tc.swiftc, "-emit-library", "-parse-as-library", "-Onone", "-module-name", f"PeekPatch{version}",
               "-swift-version", language, *self._common_flags(), "-I", str(self.out / "module"),
               "-Xfrontend", "-enable-cross-import-overlays", "-D", "DEBUG", "-D", "PEEK", "-suppress-warnings",
               *self._package_flags(), *self.extra, *self._link_flags(),
               "-Xlinker", "-install_name", "-Xlinker", f"@loader_path/{name}",
               *map(str, thunks), str(self.out / base["file"]), *([str(deps[1])] if deps else []), "-o", str(dylib)]
        proc = subprocess.run(cmd, capture_output=True, text=True, cwd=self.out)
        if proc.returncode != 0 or not dylib.exists():
            self.patch_error = self._clean(proc.stdout + proc.stderr, shown)
            return None
        self._clean_old_builds(keep={dylib})
        for f, indexes in replaced.items():
            patched[f] = patched.get(f, set()) | indexes
        return {"ok": True, "dylib": dylib, "file": name,
                "patch": {"base": base["version"], "baseFile": base["file"]}}


def unpack_object(path, folder):
    """The object files in path: SwiftBuild's `<Module>.o` is sometimes an `ar` archive.

    Linked into a library of their own, archive members are only pulled in when something
    refers to them, which nothing does, so they are extracted and linked as plain objects.
    """
    data = path.read_bytes()
    if not data.startswith(b"!<arch>\n"):
        return [path]
    found, offset, long_names = [], 8, b""
    while offset + 60 <= len(data):
        header = data[offset:offset + 60]
        name, size = header[:16].decode(errors="replace").strip(), int(header[48:58].decode().strip())
        body = data[offset + 60:offset + 60 + size]
        if name.startswith("#1/"):  # BSD long name: stored at the start of the body
            length = int(name[3:])
            name, body = body[:length].rstrip(b"\0").decode(errors="replace"), body[length:]
        elif name == "//":  # GNU long-name table
            long_names = body
        elif name.startswith("/") and name[1:].isdigit():  # GNU long name: offset into that table
            start = int(name[1:])
            name = long_names[start:long_names.find(b"/\n", start)].decode(errors="replace")
        elif name.endswith("/") and name != "/":  # GNU short name
            name = name[:-1]
        if not name.startswith("__.SYMDEF") and name.endswith(".o"):
            out = folder / f"{path.stem}-{len(found)}-{Path(name).name}"
            out.write_bytes(body)
            found.append(out)
        offset += 60 + size + (size & 1)
    return found


def thin_to_arm64(path):
    """Keeps only the plain arm64 slice of a universal (fat) Mach-O, in place. Apple's SDK
    frameworks also carry arm64e, which apps (and LiveContainer) never load: half the download."""
    with open(path, "rb") as f:
        data = f.read()
    if len(data) < 8 or data[:4] not in (b"\xca\xfe\xba\xbe", b"\xca\xfe\xba\xbf"):
        return False
    wide = data[3] == 0xBF
    count = struct.unpack(">I", data[4:8])[0]
    entry = 32 if wide else 20
    for n in range(count):
        at = 8 + n * entry
        if wide:
            cpu, sub, offset, size = struct.unpack(">iiQQ", data[at:at + 24])
        else:
            cpu, sub, offset, size = struct.unpack(">iiII", data[at:at + 16])
        if cpu == 0x0100000C and (sub & 0xFFFFFF) != 2:  # CPU_TYPE_ARM64, not arm64e
            with open(path, "wb") as f:
                f.write(data[offset:offset + size])
            return True
    return False


def write_if_changed(path, text):
    """Writes text to path unless it already holds it, so unchanged files keep their timestamps."""
    try:
        if path.read_text() == text:
            return False
    except OSError:
        pass
    path.write_text(text)
    return True


def pack_resources(files):
    """Archive for the phone: "PEEKRES1", then per file u16 path length, path, u32 size, bytes."""
    out = bytearray(b"PEEKRES1")
    for arcname, path in files:
        try:
            data = path.read_bytes()
        except OSError:
            continue
        name = arcname.encode()
        out += struct.pack(">H", len(name)) + name + struct.pack(">I", len(data)) + data
    return bytes(out)


# ------------------------------------------------------------------ signing

APPLE_CERT_URLS = {
    "root": "https://www.apple.com/appleca/AppleIncRootCertificate.cer",
    "G3": "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer",
    "G6": "https://www.apple.com/certificateauthority/AppleWWDRCAG6.cer",
    "G2": "https://www.apple.com/certificateauthority/AppleWWDRCAG2.cer",
    "G4": "https://www.apple.com/certificateauthority/AppleWWDRCAG4.cer",
    "G5": "https://www.apple.com/certificateauthority/AppleWWDRCAG5.cer",
}


class Signer:
    """Signs dylibs with the developer certificate the phone's sideloading store uses.

    iOS only loads code signed by a certificate from a provisioning profile on the
    device, with the same Team ID as the host app, so the dylib must be signed
    with that very certificate. The host app imports it from SideStore/AltStore
    and uploads it (encrypted with the pairing key) once.
    """

    def __init__(self, toolchain):
        self.tc = toolchain
        self.p12 = STATE_DIR / "cert.p12"
        self.info_path = STATE_DIR / "cert.json"
        self.info = json.loads(self.info_path.read_text()) if self.info_path.exists() and self.p12.exists() else None
        # Bundle identifier of the app that loads the builds, as reported by the phone. A free
        # developer account's profile names one explicit app ID, and iOS matches code without
        # entitlements against it by signing identifier, so builds are signed under that name.
        self.identifier_path = STATE_DIR / "identifier"
        self.identifier = self.identifier_path.read_text().strip() if self.identifier_path.exists() else None

    @property
    def ready(self):
        return self.info is not None

    def stamp(self):
        try:
            return self.info_path.stat().st_mtime_ns
        except OSError:
            return None

    def key(self):
        """Changes whenever builds have to be signed differently."""
        return f"{self.identifier}|{self.stamp()}"

    def reload(self):
        self.info = json.loads(self.info_path.read_text()) if self.info_path.exists() and self.p12.exists() else None

    def _openssl(self, *args, data=None, env=None):
        return subprocess.run([self.tc.openssl, *args], input=data, capture_output=True,
                              env={**os.environ, **(env or {})})

    def _extract(self, p12_path, password):
        """Returns (key_pem, cert_pem) from a PKCS#12: the private key and the certificate that goes with it."""
        secret = {"PEEK_P12_PASSWORD": password}  # not in argv, where `ps` would show it
        for legacy in ([], ["-legacy"]):
            base = ["pkcs12", "-in", str(p12_path), "-passin", "env:PEEK_P12_PASSWORD", *legacy]
            key = self._openssl(*base, "-nocerts", "-nodes", env=secret)
            certs = self._openssl(*base, "-nokeys", env=secret)
            if key.returncode != 0 or certs.returncode != 0 or b"PRIVATE KEY" not in key.stdout:
                continue
            found = re.findall(rb"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----\n?", certs.stdout, re.S)
            if not found:
                raise ValueError("the .p12 file contains a private key but no certificate")
            # Stores do not always tag which certificate belongs to the key, so match by public key.
            public = self._openssl("pkey", "-pubout", data=key.stdout).stdout
            for cert in found:
                if public and self._openssl("x509", "-noout", "-pubkey", data=cert).stdout == public:
                    return key.stdout, cert
            return key.stdout, found[0]
        raise ValueError("could not read the certificate (wrong password or unsupported format)")

    def _apple_cert(self, name):
        cache = STATE_DIR / f"apple-{name}.pem"
        if not cache.exists():
            der = urllib.request.urlopen(APPLE_CERT_URLS[name], timeout=20).read()
            pem = self._openssl("x509", "-inform", "DER", "-outform", "PEM", data=der)
            if pem.returncode != 0:
                raise ValueError(f"could not fetch Apple {name} certificate")
            cache.write_bytes(pem.stdout)
        return cache.read_bytes()

    def install(self, p12_bytes, password):
        private_dir()
        raw = STATE_DIR / "cert-upload.p12"
        write_private(raw, p12_bytes)
        try:
            key, cert = self._extract(raw, password)
        finally:
            raw.unlink(missing_ok=True)
        text = self._openssl("x509", "-noout", "-subject", "-issuer", "-enddate", "-nameopt", "RFC2253", data=cert).stdout.decode(errors="replace")

        def field(pattern, source=text):
            m = re.search(pattern, source)
            return m.group(1).strip() if m else None

        subject = field(r"subject=\s*(.*)") or ""
        issuer = field(r"issuer=\s*(.*)") or ""
        team = re.search(r"OU=([A-Z0-9]{10})", subject)
        common = re.search(r"CN=((?:\\.|[^,])*)", subject)
        generation = re.search(r"OU=(G\d)", issuer)
        chain = b""
        try:
            chain = self._apple_cert(generation.group(1) if generation else "G3") + self._apple_cert("root")
        except Exception as e:  # signing still works without the chain on some iOS versions
            log(f"warning: could not fetch Apple intermediate certificates ({e})", "yellow")
        work = STATE_DIR / "cert-work"
        shutil.rmtree(work, ignore_errors=True)
        work.mkdir(mode=0o700)
        try:
            write_private(work / "key.pem", key)
            write_private(work / "cert.pem", cert)
            write_private(work / "chain.pem", chain)
            if self.p12.exists():
                os.chmod(self.p12, 0o600)
            else:
                write_private(self.p12, b"")
            cmd = ["pkcs12", "-export", "-inkey", str(work / "key.pem"), "-in", str(work / "cert.pem"),
                   "-out", str(self.p12), "-passout", "pass:"]
            if chain:
                cmd += ["-certfile", str(work / "chain.pem")]
            done = self._openssl(*cmd)
            if done.returncode != 0:
                raise ValueError("could not repack certificate: " + done.stderr.decode(errors="replace")[-200:])
        finally:
            shutil.rmtree(work, ignore_errors=True)
        os.chmod(self.p12, 0o600)
        self.info = {
            "team": team.group(1) if team else None,
            "name": common.group(1).replace("\\", "") if common else (subject or "certificate"),
            "expires": field(r"notAfter=(.*)") or "unknown",
        }
        self.info_path.write_text(json.dumps(self.info))
        return self.info

    def adopt(self, identifier):
        """Records the host app's bundle identifier; true when it changed."""
        if not identifier or not re.fullmatch(r"[A-Za-z0-9.\-]+", identifier) or identifier == self.identifier:
            return False
        self.identifier = identifier
        private_dir()
        self.identifier_path.write_text(identifier)
        return True

    def sign_in_place(self, binary):
        proc = subprocess.run([self.tc.ldid, f"-K{self.p12}", "-U",
                               *([f"-I{self.identifier}"] if self.identifier else []), "-S", str(binary)],
                              capture_output=True, text=True)
        if proc.returncode != 0:
            raise RuntimeError("ldid failed: " + (proc.stderr or proc.stdout).strip())

    def sign(self, dylib):
        """Signs a copy of dylib and returns its path."""
        signed = dylib.with_name(f"{dylib.stem}.signed.dylib")
        shutil.copyfile(dylib, signed)
        proc = subprocess.run([self.tc.ldid, f"-K{self.p12}", "-U",
                               *([f"-I{self.identifier}"] if self.identifier else []), "-S", str(signed)],
                              capture_output=True, text=True)
        if proc.returncode != 0:
            raise RuntimeError("ldid failed: " + (proc.stderr or proc.stdout).strip())
        return signed

    def fingerprint(self):
        """SHA-256 of the signing certificate (DER), as the phone computes it from its provisioning profile."""
        pem = self._openssl("pkcs12", "-in", str(self.p12), "-passin", "pass:", "-clcerts", "-nokeys").stdout
        der = self._openssl("x509", "-outform", "DER", data=pem).stdout
        return hashlib.sha256(der).hexdigest() if der else None


