#
# Keys are derived from the pairing token. Responses and sensitive request bodies are sealed
# with AES-256-CTR + HMAC-SHA256 (encrypt-then-MAC). AES comes from the openssl CLI, so only
# the standard library is needed; the phone uses CommonCrypto.

OPENSSL = shutil.which("openssl") or "openssl"
SEALED_TYPE = "application/x-peek-sealed"
COPY_NAME_RE = re.compile(r"\b[0-9a-f]{8}_[\w.+-]+\.swift\b")  # peek's copies of the sources
DUPLICATE_CLASS_RE = re.compile(r"objc\[\d+\]: Class \S+ is implemented in both ")


class TestReport:
    """Results of one `peek test` run, read from the console output the phone forwards."""

    XCTEST_CASE = re.compile(r"Test Case '-\[(?:\w+\.)?(\w+) (\w+)\]' (passed|failed|skipped) \((\d+(?:\.\d+)?) seconds\)")
    XCTEST_ISSUE = re.compile(r"^(.*?): error: -\[(?:\w+\.)?(\w+) (\w+)\] : (.*)$")
    SWIFT_TESTING_DONE = re.compile(r"^\s*[✔✘↷] Test (.+?) (passed|failed|skipped)(?: after (\d+(?:\.\d+)?) seconds)?")
    SWIFT_TESTING_ISSUE = re.compile(r"^\s*✘ Test (.+?) recorded an issue(?: at (\S+))?: (.*)$")
    DONE = {"peek: all tests passed": 0, "peek: tests failed": 1}

    def __init__(self):
        self.cases = []  # (suite, name, outcome, seconds, [messages])
        self.issues = {}  # (suite, name) -> messages seen before the case finished

    def feed(self, line):
        """Takes one output line; returns 0 or 1 once the run has finished, else None."""
        line = line.strip()
        if line == "peek: tests started":
            self.cases, self.issues = [], {}
            return None
        if line in self.DONE:
            return self.DONE[line]
        m = self.XCTEST_ISSUE.match(line)
        if m:
            self.issues.setdefault((m.group(2), m.group(3)), []).append(f"{m.group(1)}: {m.group(4)}")
            return None
        m = self.SWIFT_TESTING_ISSUE.match(line)
        if m:
            self.issues.setdefault(("Swift Testing", m.group(1)), []).append(f"{m.group(2) or ''}: {m.group(3)}".lstrip(": "))
            return None
        m = self.XCTEST_CASE.search(line)
        if m:
            self._finish(m.group(1), m.group(2), m.group(3), float(m.group(4)))
            return None
        m = self.SWIFT_TESTING_DONE.match(line)
        if m and not m.group(1).startswith("run with "):
            self._finish("Swift Testing", m.group(1), m.group(2), float(m.group(3) or 0))
        return None

    def _finish(self, suite, name, outcome, seconds):
        self.cases.append((suite, name, outcome, seconds, self.issues.pop((suite, name), [])))

    def junit(self):
        """The run as JUnit XML, which CI services show as test results."""
        import xml.etree.ElementTree as ET
        root = ET.Element("testsuites", name="peek test")
        suites = {}
        for suite, name, outcome, seconds, messages in self.cases:
            if suite not in suites:
                suites[suite] = ET.SubElement(root, "testsuite", name=suite)
            case = ET.SubElement(suites[suite], "testcase", classname=suite, name=name, time=f"{seconds:.3f}")
            if outcome == "failed":
                ET.SubElement(case, "failure", message=(messages or ["failed"])[0]).text = "\n".join(messages)
            elif outcome == "skipped":
                ET.SubElement(case, "skipped")
        for element in [root, *suites.values()]:
            cases = element.iter("testcase")
            listed = list(cases)
            element.set("tests", str(len(listed)))
            element.set("failures", str(sum(1 for c in listed if c.find("failure") is not None)))
            element.set("skipped", str(sum(1 for c in listed if c.find("skipped") is not None)))
            element.set("time", f"{sum(float(c.get('time')) for c in listed):.3f}")
        ET.indent(root)
        return ET.tostring(root, encoding="unicode", xml_declaration=True) + "\n"


def derive(token, label):
    return hmac.new(bytes.fromhex(token), label.encode(), hashlib.sha256).digest()


def _aes_ctr(key, nonce, data):
    if not data:
        return b""
    proc = subprocess.run([OPENSSL, "enc", "-aes-256-ctr", "-nosalt", "-K", key.hex(), "-iv", nonce.hex()],
                          input=data, capture_output=True)
    if proc.returncode != 0 or len(proc.stdout) != len(data):
        raise RuntimeError("openssl enc failed: " + proc.stderr.decode(errors="replace").strip())
    return proc.stdout


def seal(token, data):
    """nonce(16) | AES-256-CTR(data) | HMAC-SHA256(nonce | ciphertext)."""
    nonce = os.urandom(16)
    body = _aes_ctr(derive(token, "peek-enc"), nonce, data)
    return nonce + body + hmac.new(derive(token, "peek-mac"), nonce + body, hashlib.sha256).digest()


def unseal(token, blob):
    if len(blob) < 48:
        raise ValueError("short message")
    nonce, body, tag = blob[:16], blob[16:-32], blob[-32:]
    if not hmac.compare_digest(tag, hmac.new(derive(token, "peek-mac"), nonce + body, hashlib.sha256).digest()):
        raise ValueError("bad authentication tag")
    return _aes_ctr(derive(token, "peek-enc"), nonce, body)


def auth_message(method, path, stamp, body, bundle, device):
    """What `X-Peek-Auth` signs: the request line, the time, the body and the headers the server acts on."""
    return f"{method}\n{path}\n{stamp}\n{hashlib.sha256(body).hexdigest()}\n{bundle}\n{device}".encode()


def auth_header(token, method, path, body=b"", bundle="", device=""):
    stamp = int(time.time())
    mac = hmac.new(derive(token, "peek-auth"), auth_message(method, path, stamp, body, bundle, device), hashlib.sha256)
    return f"{stamp}:{mac.hexdigest()}"


# ----------------------------------------------------------------- QR code

# Per version 1-10 at error correction level L: (EC codewords per block, [data codewords per block]).
QR_BLOCKS = {1: (7, [19]), 2: (10, [34]), 3: (15, [55]), 4: (20, [80]), 5: (26, [108]),
             6: (18, [68, 68]), 7: (20, [78, 78]), 8: (24, [97, 97]), 9: (30, [116, 116]),
             10: (18, [68, 68, 69, 69])}
QR_ALIGNMENT = {1: [], 2: [6, 18], 3: [6, 22], 4: [6, 26], 5: [6, 30], 6: [6, 34],
                7: [6, 22, 38], 8: [6, 24, 42], 9: [6, 26, 46], 10: [6, 28, 50]}


def _rs_remainder(data, degree):
    """Reed-Solomon error correction codewords over GF(2^8) mod 0x11D."""
    def mul(x, y):
        z = 0
        for i in range(7, -1, -1):
            z = (z << 1) ^ ((z >> 7) * 0x11D)
            z ^= ((y >> i) & 1) * x
        return z
    generator, root = [0] * (degree - 1) + [1], 1
    for _ in range(degree):
        for j in range(degree):
            generator[j] = mul(generator[j], root)
            if j + 1 < degree:
                generator[j] ^= generator[j + 1]
        root = mul(root, 2)
    result = [0] * degree
    for byte in data:
        factor = byte ^ result.pop(0)
        result.append(0)
        result = [r ^ mul(g, factor) for r, g in zip(result, generator)]
    return result


def qr_matrix(text):
    """Encodes text as a QR code (byte mode, level L). Returns rows of booleans, True = dark."""
    payload = text.encode()
    for version in range(1, 11):
        ec_len, blocks = QR_BLOCKS[version]
        capacity = sum(blocks)
        count_bits = 8 if version < 10 else 16
        if len(payload) * 8 + 4 + count_bits <= capacity * 8:
            break
    else:
        raise ValueError("text too long for a QR code")
    bits = [0, 1, 0, 0] + [(len(payload) >> i) & 1 for i in range(count_bits - 1, -1, -1)]
    for byte in payload:
        bits += [(byte >> i) & 1 for i in range(7, -1, -1)]
    bits += [0] * min(4, capacity * 8 - len(bits))
    bits += [0] * (-len(bits) % 8)
    data = [int("".join(map(str, bits[i:i + 8])), 2) for i in range(0, len(bits), 8)]
    data += [0xEC, 0x11] * capacity
    data = data[:capacity]

    chunks, ec_chunks, offset = [], [], 0
    for length in blocks:
        chunk = data[offset:offset + length]
        offset += length
        chunks.append(chunk)
        ec_chunks.append(_rs_remainder(chunk, ec_len))
    stream = [c[i] for i in range(max(blocks)) for c in chunks if i < len(c)]
    stream += [c[i] for i in range(ec_len) for c in ec_chunks]

    size = 17 + 4 * version
    dark = [[False] * size for _ in range(size)]
    fixed = [[False] * size for _ in range(size)]

    def put(x, y, value):
        if 0 <= x < size and 0 <= y < size:
            dark[y][x], fixed[y][x] = bool(value), True

    for i in range(size):  # timing patterns
        put(6, i, i % 2 == 0)
        put(i, 6, i % 2 == 0)
    for cx, cy in ((3, 3), (size - 4, 3), (3, size - 4)):  # finders with separators
        for dy in range(-4, 5):
            for dx in range(-4, 5):
                put(cx + dx, cy + dy, max(abs(dx), abs(dy)) not in (2, 4))
    centers = QR_ALIGNMENT[version]
    for cy in centers:
        for cx in centers:
            if (cx, cy) in ((6, 6), (6, centers[-1]), (centers[-1], 6)):
                continue
            for dy in range(-2, 3):
                for dx in range(-2, 3):
                    put(cx + dx, cy + dy, max(abs(dx), abs(dy)) != 1)

    def put_format(mask):
        value = (1 << 3) | mask  # level L
        rem = value
        for _ in range(10):
            rem = (rem << 1) ^ ((rem >> 9) * 0x537)
        code = ((value << 10) | rem) ^ 0x5412
        bit = lambda i: (code >> i) & 1
        for i in range(6):
            put(8, i, bit(i))
        put(8, 7, bit(6))
        put(8, 8, bit(7))
        put(7, 8, bit(8))
        for i in range(9, 15):
            put(14 - i, 8, bit(i))
        for i in range(8):
            put(size - 1 - i, 8, bit(i))
        for i in range(8, 15):
            put(8, size - 15 + i, bit(i))
        put(8, size - 8, True)

    put_format(0)  # reserve the area
    if version >= 7:
        rem = version
        for _ in range(12):
            rem = (rem << 1) ^ ((rem >> 11) * 0x1F25)
        code = (version << 12) | rem
        for i in range(18):
            a, b = size - 11 + i % 3, i // 3
            put(a, b, (code >> i) & 1)
            put(b, a, (code >> i) & 1)

    index = 0
    for right in range(size - 1, 0, -2):  # zigzag data placement
        if right <= 6:
            right -= 1
        for vertical in range(size):
            for j in range(2):
                x = right - j
                y = size - 1 - vertical if (right + 1) & 2 == 0 else vertical
                if not fixed[y][x] and index < len(stream) * 8:
                    dark[y][x] = bool((stream[index >> 3] >> (7 - (index & 7))) & 1)
                    index += 1

    masks = [lambda x, y: (x + y) % 2, lambda x, y: y % 2, lambda x, y: x % 3,
             lambda x, y: (x + y) % 3, lambda x, y: (x // 3 + y // 2) % 2,
             lambda x, y: x * y % 2 + x * y % 3, lambda x, y: (x * y % 2 + x * y % 3) % 2,
             lambda x, y: ((x + y) % 2 + x * y % 3) % 2]

    def penalty(grid):
        score = 0
        for lines in (grid, list(zip(*grid))):
            for line in lines:
                run = 1
                for i in range(1, size):
                    if line[i] == line[i - 1]:
                        run += 1
                    else:
                        score += run - 2 if run >= 5 else 0
                        run = 1
                score += run - 2 if run >= 5 else 0
                text = "".join("1" if v else "0" for v in line)
                score += 40 * (text.count("10111010000") + text.count("00001011101"))
        for y in range(size - 1):
            for x in range(size - 1):
                if grid[y][x] == grid[y][x + 1] == grid[y + 1][x] == grid[y + 1][x + 1]:
                    score += 3
        ratio = sum(map(sum, grid)) * 20 // (size * size)
        return score + 10 * abs(ratio - 10)

    best = None
    for number, mask in enumerate(masks):
        grid = [[dark[y][x] ^ (not fixed[y][x] and mask(x, y) == 0) for x in range(size)] for y in range(size)]
        saved = dark
        dark = grid
        put_format(number)
        dark = saved
        score = penalty(grid)
        if best is None or score < best[0]:
            best = (score, grid)
    return best[1]


def qr_text(text, margin=2):
    """Renders a QR code with half-block characters, black on white regardless of terminal theme."""
    grid = qr_matrix(text)
    size = len(grid) + 2 * margin
    cell = lambda x, y: 0 <= y - margin < len(grid) and 0 <= x - margin < len(grid) and grid[y - margin][x - margin]
    lines = []
    for y in range(0, size, 2):
        row = ""
        for x in range(size):
            top, bottom = cell(x, y), cell(x, y + 1) if y + 1 < size else False
            row += "\033[%d;%dm▀" % (30 if top else 97, 40 if bottom else 107)
        lines.append("  " + row + "\033[0m")
    return "\n".join(lines)


