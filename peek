    // Xcode injects into the app. Peek has no such agent, so testmanagerd falls back to an
    // "implicit confirmation" delay (5 s by default). The runner chooses that delay.
    if let session = NSClassFromString("XCTRunnerDaemonSession"),
       let method = class_getInstanceMethod(session, NSSelectorFromString("implicitEventConfirmationIntervalForCurrentContext")) {
        let interval: @convention(block) (AnyObject) -> Double = { _ in 0.2 }
        method_setImplementation(method, imp_implementationWithBlock(interval))
    }
    // With that short delay the call returns while a long event (typing a word, a swipe) is
    // still playing: let the app's run loop turn until the whole event has been delivered.
    if let record = NSClassFromString("XCSynthesizedEventRecord"),
       let method = class_getInstanceMethod(record, NSSelectorFromString("synthesizeWithError:")),
       let originalIMP = __peekOriginal(record, "synthesizeWithError:") {
        typealias Synthesize = @convention(c) (AnyObject, Selector, UnsafeMutablePointer<NSError?>?) -> Bool
        let original = unsafeBitCast(originalIMP, to: Synthesize.self)
        let selector = NSSelectorFromString("synthesizeWithError:")
        let replacement: @convention(block) (AnyObject, UnsafeMutablePointer<NSError?>?) -> Bool = { event, error in
            let started = Date()
            let ok = original(event, selector, error)
            let duration = (event.value(forKey: "maximumOffset") as? Double) ?? 0
            let end = started.addingTimeInterval(duration + 0.3)  // and the screen update after the last one
            while Date() < end { RunLoop.current.run(until: min(end, Date().addingTimeInterval(0.05))) }
            return ok
        }
        method_setImplementation(method, imp_implementationWithBlock(replacement))
    }
    typealias IsEnabled = @convention(c) () -> Bool
    let handle = dlopen("/System/Library/PrivateFrameworks/AutomationMode.framework/AutomationMode", RTLD_NOW)
    let isEnabled = dlsym(handle, "XAMIsAutomationModeEnabled").map { unsafeBitCast($0, to: IsEnabled.self) }
    print("peek: Automation Mode was \\(isEnabled?() == true ? "on" : "off")")
    if isEnabled?() == true { return }
    let device = XCUIDevice.shared
    let selector = NSSelectorFromString("enableAutomationMode:")
    guard let method = class_getInstanceMethod(object_getClass(device), selector) else { return }
    typealias Enable = @convention(c) (AnyObject, Selector, UnsafeMutablePointer<NSError?>?) -> Bool
    var error: NSError?
    __peekNotice("Enter your passcode to allow Automation Mode for the UI tests")
    defer { __peekNotice(isEnabled?() == true ? nil : "Automation Mode is off, so UI tests cannot drive the app") }
    let ok = unsafeBitCast(method_getImplementation(method), to: Enable.self)(device, selector, &error)
    print("peek: Automation Mode \\(ok ? "requested" : "not enabled: \\(error?.localizedDescription ?? "unknown error")")")
    // The passcode prompt may still be up; wait for the mode to actually switch on.
    let deadline = Date().addingTimeInterval(60)
    while isEnabled?() == false, Date() < deadline {
        RunLoop.current.run(until: Date().addingTimeInterval(0.25))
    }
    print("peek: Automation Mode is \\(isEnabled?() == true ? "on" : "still off")")
}

/// launchArguments and launchEnvironment of XCUIApplication, applied to this process the way a
/// real launch would: environment variables, ProcessInfo.arguments, and `-key value` pairs in
/// UserDefaults' argument domain.
nonisolated(unsafe) var __peekLaunchArguments: [String] = []
/// The bundle identifier iOS knows the app under test by, and whether terminate() took it down.
nonisolated(unsafe) var __peekTargetBundle = ""
nonisolated(unsafe) var __peekTerminated = false

func __peekIsTarget(_ app: AnyObject) -> Bool {
    guard !__peekTargetBundle.isEmpty, app.responds(to: NSSelectorFromString("bundleID")) else { return true }
    return (app.value(forKey: "bundleID") as? String).map { $0 == __peekTargetBundle } ?? true
}

/// Lets the run loop turn for `minimum` seconds and then while a scroll view is still moving (3 s at most).
@MainActor func __peekSettle(_ minimum: Double) {
    RunLoop.current.run(until: Date().addingTimeInterval(minimum))
    func moving(_ view: UIView) -> Bool {
        if let scroll = view as? UIScrollView, scroll.isDragging || scroll.isDecelerating { return true }
        return view.subviews.contains(where: moving)
    }
    let deadline = Date().addingTimeInterval(3)
    while Date() < deadline, UIApplication.shared.connectedScenes.contains(where: {
        ($0 as? UIWindowScene)?.windows.contains(where: moving) ?? false
    }) {
        RunLoop.current.run(until: Date().addingTimeInterval(0.05))
    }
}

/// The implementation a method had before any peek build replaced it. Each build is a module of
/// its own and replaces the same methods again (the process keeps them): taking the current
/// implementation as "the original" would chain every earlier build's replacement, and its
/// stale state, into this one. The first original is kept under a second selector.
func __peekOriginal(_ cls: AnyClass, _ name: String) -> IMP? {
    let saved = NSSelectorFromString("__peekOriginal_" + name)
    if let kept = class_getInstanceMethod(cls, saved) { return method_getImplementation(kept) }
    guard let method = class_getInstanceMethod(cls, NSSelectorFromString(name)) else { return nil }
    class_addMethod(cls, saved, method_getImplementation(method), method_getTypeEncoding(method))
    return method_getImplementation(method)
}

/// The original XCUIApplication.activate().
nonisolated(unsafe) var __peekActivate: (AnyObject) -> Void = { _ in }

@MainActor func __peekRelaunch(_ app: AnyObject) {
    // A test that left another app in front (or failed there) must not leave the next one
    // driving an app in the background.
    if UIApplication.shared.applicationState != .active { __peekActivate(app) }
    __peekTerminated = false
    __peekApplyLaunchOptions(app)
    NotificationCenter.default.post(name: __peekRelaunchNotification, object: nil)
    // XCTest would now wait for the new app to settle, a wait cut short here. Wait until its
    // view tree stops changing instead (a Form adds its rows over several layout passes).
    func views(_ view: UIView) -> Int { 1 + view.subviews.reduce(0) { $0 + views($1) } }
    var last = -1, steady = 0
    let deadline = Date().addingTimeInterval(3)
    while steady < 3, Date() < deadline {
        RunLoop.current.run(until: Date().addingTimeInterval(0.1))
        var count = 0
        for case let scene as UIWindowScene in UIApplication.shared.connectedScenes {
            for window in scene.windows {
                window.layoutIfNeeded()
                count += views(window)
            }
        }
        steady = count == last ? steady + 1 : 0
        last = count
    }
    RunLoop.current.run(until: Date().addingTimeInterval(0.2))
}

/// Hooks ProcessInfo.arguments for this build (once): the process's own arguments, then those of
/// the last launch().
nonisolated(unsafe) var __peekArgumentsHooked = false

func __peekApplyLaunchOptions(_ app: AnyObject) {
    // Variables the last launch() set (by any build, so kept in the environment itself) are
    // put back first: a real launch would not pass them on to the next one.
    let ledger = "PEEK_LAUNCHED_ENVIRONMENT"
    if let saved = getenv(ledger).flatMap({ try? JSONSerialization.jsonObject(with: Data(String(cString: $0).utf8)) as? [String: Any] }) {
        for (key, before) in saved {
            if let before = before as? String { setenv(key, before, 1) } else { unsetenv(key) }
        }
    }
    let environment = (app.value(forKey: "launchEnvironment") as? [String: String]) ?? [:]
    let before = Dictionary(uniqueKeysWithValues: environment.keys.map { ($0, getenv($0).map { String(cString: $0) as Any } ?? NSNull()) })
    if let data = try? JSONSerialization.data(withJSONObject: before) { setenv(ledger, String(decoding: data, as: UTF8.self), 1) }
    for (key, value) in environment { setenv(key, value, 1) }
    let arguments = (app.value(forKey: "launchArguments") as? [String]) ?? []
    // The concrete class: since iOS 17 ProcessInfo is a Swift subclass with its own getter.
    if !__peekArgumentsHooked, let cls = object_getClass(ProcessInfo.processInfo),
       let original = __peekOriginal(cls, "arguments"),
       let method = class_getInstanceMethod(cls, #selector(getter: ProcessInfo.arguments)) {
        typealias Get = @convention(c) (AnyObject, Selector) -> NSArray
        let combined: @convention(block) (AnyObject) -> NSArray = { info in
            let own = unsafeBitCast(original, to: Get.self)(info, #selector(getter: ProcessInfo.arguments)) as? [String] ?? []
            return (own + __peekLaunchArguments) as NSArray
        }
        method_setImplementation(method, imp_implementationWithBlock(combined))
        __peekArgumentsHooked = true
    }
    __peekLaunchArguments = arguments
    var defaults: [String: Any] = [:]
    var index = 0
    while index < arguments.count {
        let argument = arguments[index]
        if argument.hasPrefix("-"), argument.count > 1, index + 1 < arguments.count {
            let value = arguments[index + 1]
            if let data = value.data(using: .utf8),
               let parsed = try? PropertyListSerialization.propertyList(from: data, format: nil) {
                defaults[String(argument.dropFirst())] = parsed
            } else {
                defaults[String(argument.dropFirst())] = value
            }
            index += 2
        } else {
            index += 1
        }
    }
    UserDefaults.standard.setVolatileDomain(defaults, forName: UserDefaults.argumentDomain)
}

/// UI tests may open other apps, which sends Peek (and the tests running in it) to the
/// background, where iOS suspends it within seconds. Keep it running with whatever the app
/// hosting Peek allows: a background task (about 30 s), silent audio or location updates
/// (for as long as needed, if its Info.plist has those background modes).
@MainActor final class __PeekBackgroundKeeper: NSObject, CLLocationManagerDelegate {
    static let shared = __PeekBackgroundKeeper()
    private var task = UIBackgroundTaskIdentifier.invalid
    private var player: AVAudioPlayer?
    private var location: CLLocationManager?

    func start() {
        let host = URL(fileURLWithPath: CommandLine.arguments[0]).deletingLastPathComponent()
        let info = NSDictionary(contentsOf: host.appendingPathComponent("Info.plist"))
        let modes = (info?["UIBackgroundModes"] as? [String]) ?? []
        var kept = ["background task"]
        task = UIApplication.shared.beginBackgroundTask(withName: "peek tests") { [weak self] in self?.endTask() }
        if modes.contains("audio"), startSilentAudio() { kept.append("silent audio") }
        // CoreLocation checks the main bundle (Peek's, under LiveContainer) for the mode too.
        let ownModes = (Bundle.main.object(forInfoDictionaryKey: "UIBackgroundModes") as? [String]) ?? []
        if modes.contains("location"), ownModes.contains("location"),
           [.authorizedAlways, .authorizedWhenInUse].contains(CLLocationManager().authorizationStatus) {
            let manager = CLLocationManager()
            manager.delegate = self
            manager.allowsBackgroundLocationUpdates = true
            manager.pausesLocationUpdatesAutomatically = false
            manager.desiredAccuracy = kCLLocationAccuracyThreeKilometers
            manager.startUpdatingLocation()
            location = manager
            kept.append("location updates")
        }
        print("peek: kept alive in the background by \\(kept.joined(separator: ", ")) (host background modes: \\(modes))")
    }

    func stop() {
        player?.stop(); player = nil
        location?.stopUpdatingLocation(); location = nil
        endTask()
    }

    private func endTask() {
        if task != .invalid { UIApplication.shared.endBackgroundTask(task); task = .invalid }
    }

    private func startSilentAudio() -> Bool {
        do {
            try AVAudioSession.sharedInstance().setCategory(.playback, options: [.mixWithOthers])
            try AVAudioSession.sharedInstance().setActive(true)
            // One second of silence as a WAV file, looped.
            var wav = Data()
            func append<T>(_ value: T) { withUnsafeBytes(of: value) { wav.append(contentsOf: $0) } }
            let samples = 8000
            wav.append(contentsOf: Array("RIFF".utf8)); append(UInt32(36 + samples * 2).littleEndian)
            wav.append(contentsOf: Array("WAVEfmt ".utf8)); append(UInt32(16).littleEndian); append(UInt16(1).littleEndian)
            append(UInt16(1).littleEndian); append(UInt32(8000).littleEndian); append(UInt32(16000).littleEndian)
            append(UInt16(2).littleEndian); append(UInt16(16).littleEndian)
            wav.append(contentsOf: Array("data".utf8)); append(UInt32(samples * 2).littleEndian)
            wav.append(Data(count: samples * 2))
            let player = try AVAudioPlayer(data: wav)
            player.numberOfLoops = -1
            player.volume = 0
            guard player.play() else { return false }
            self.player = player
            return true
        } catch {
            return false
        }
    }
}

/// XCUITest reads an app through its accessibility server, which apps start only when launched
/// with accessibility or automation on. Peek was already running, so start it here and wait
/// until UIKit's accessibility bundle is loaded.
@MainActor func __peekStartAccessibility() {
    typealias SetFlag = @convention(c) (Bool) -> Void
    let library = dlopen("/usr/lib/libAccessibility.dylib", RTLD_NOW)
    for name in ["_AXSSetAutomationEnabled", "_AXSApplicationAccessibilitySetEnabled"] {
        if let symbol = dlsym(library, name) { unsafeBitCast(symbol, to: SetFlag.self)(true) }
    }
    // What UIKit runs at launch when accessibility is on.
    typealias Initialize = @convention(c) () -> Void
    if let symbol = dlsym(UnsafeMutableRawPointer(bitPattern: -2), "_UIAccessibilityInitialize") {
        unsafeBitCast(symbol, to: Initialize.self)()
    }
    func loaded() -> Bool { Bundle.allBundles.contains { $0.bundlePath.hasSuffix("UIKit.axbundle") } }
    let deadline = Date().addingTimeInterval(15)
    while !loaded(), Date() < deadline {
        RunLoop.current.run(until: Date().addingTimeInterval(0.25))
    }
    // Give the server a moment to register once the bundles are in.
    RunLoop.current.run(until: Date().addingTimeInterval(1))
    print("peek: accessibility \\(loaded() ? "ready" : "not loaded yet")")
}

/// XCTest connects to testmanagerd, which only runs when Xcode has set the phone up for
/// development; unit tests do not need it. Make XCTest see no daemon session instead of failing.
@MainActor func __peekWithoutTestDaemon() {
    guard let session = NSClassFromString("XCTRunnerDaemonSession") else { return }
    let none: @convention(block) (AnyObject) -> AnyObject? = { _ in nil }
    let noneWithFlag: @convention(block) (AnyObject, Bool) -> AnyObject? = { _, _ in nil }
    for (name, block) in [("sharedSession", none as Any), ("sharedSessionIfInitiated", none),
                          ("sharedSessionPromiseAndImplicitlyInitiateSession:", noneWithFlag)] {
        if let method = class_getClassMethod(session, NSSelectorFromString(name)) {
            method_setImplementation(method, imp_implementationWithBlock(block))
        }
    }
}
