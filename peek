CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def printable(text):
    """Text from the phone with terminal control characters (escape sequences) removed."""
    return CONTROL_RE.sub("", str(text))


def private_dir():
    """The state folder, readable by this user only (it holds the signing key)."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    return STATE_DIR


def write_private(path, data):
    """Writes a file created with mode 0600."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data if isinstance(data, bytes) else data.encode())
    os.chmod(path, 0o600)


def log(msg, color=None):
    codes = {"red": 31, "green": 32, "yellow": 33, "dim": 2, "bold": 1}
    stamp = time.strftime("%H:%M:%S")
    msg = printable(msg)
    if color and sys.stdout.isatty():
        msg = f"\033[{codes[color]}m{msg}\033[0m"
    print(f"[{stamp}] {msg}", flush=True)


# ---------------------------------------------------------------- toolchain

class Toolchain:
    """Locates swiftc, the Darwin Swift SDK bundle, and ldid."""

    def __init__(self, strict=True):
        self.swiftc = self._find("swiftc", [Path.home() / ".local/share/swiftly/bin/swiftc"])
        self.ldid = self._find("ldid", [Path.home() / ".local/bin/ldid"])
        self.openssl = self._find("openssl", [])
        self.sdk = self.resources = self.linker = self.runtime = self.bundle = None
        for root in (Path.home() / ".swiftpm/swift-sdks", Path.home() / "Library/org.swift.swiftpm/swift-sdks"):
            for manifest in sorted(root.glob("*.artifactbundle/swift-sdk.json")):
                try:
                    triple = json.loads(manifest.read_text())["targetTriples"]["arm64-apple-ios"]
                except (KeyError, ValueError):
                    continue
                bundle = self.bundle = manifest.parent
                self.sdk = bundle / triple["sdkRootPath"]
                self.resources = bundle / triple["swiftResourcesPath"]
                linker = bundle / "toolset/bin/ld64.lld"
                self.linker = linker if linker.exists() else None
                runtime = sorted(self.resources.parent.glob("clang/*/lib/darwin/libclang_rt.ios.a"))
                self.runtime = runtime[-1] if runtime else None
        missing = [n for n, v in (("swiftc", self.swiftc), ("ldid", self.ldid), ("openssl", self.openssl),
                                  ("a Darwin Swift SDK (install with `xtool sdk install`)", self.sdk)) if not v]
        self.missing = missing
        if missing and strict:
            sys.exit("peek: missing " + ", ".join(missing) + " (run `peek doctor` for details)")

    def swift_build(self, package_dir, scratch, extra=()):
        """Builds a package for iOS the way xtool does (SwiftPM's swiftbuild backend)."""
        swift = Path(self.swiftc).with_name("swift")
        cmd = [str(swift) if swift.exists() else "swift", "build", "--configuration", "debug",
               "--build-system", "swiftbuild", "--triple", "arm64-apple-ios", "--scratch-path", str(scratch),
               *extra]
        for name in ("toolset-swb.json", "toolset.json"):
            if (self.bundle / name).exists():
                cmd += ["--toolset", str(self.bundle / name)]
                break
        return subprocess.run(cmd, cwd=package_dir, capture_output=True, text=True, env=self.swift_env())

    def swift_env(self):
        env = dict(os.environ)
        env["XCODE_EXTRA_PLATFORM_FOLDERS"] = str(self.bundle / "Developer/Platforms")
        env["PATH"] = f"{self.bundle / 'toolset/bin'}:{Path(self.swiftc).parent}:{env.get('PATH', '')}"
        return env

    @staticmethod
    def _find(name, extra):
        found = shutil.which(name)
        if found:
            return found
        for candidate in extra:
            if candidate.exists():
                return str(candidate)
        return None


# ------------------------------------------------------------ source rewrite

def _string_end(src, i):
    """If src[i] starts a string literal (plain, multi-line or raw), return the index just past it; else i.

    Interpolations (`\\(...)`, `\\#(...)` in raw strings) may hold code with strings of their own.
    """
    j = i
    while j < len(src) and src[j] == "#":
        j += 1
    hashes = j - i
    if not src.startswith('"', j):
        return i
    multi = src.startswith('"""', j)
    close = ('"""' if multi else '"') + "#" * hashes
    escape = "\\" + "#" * hashes
    j += 3 if multi else 1
    while j < len(src):
        if src.startswith(escape, j):
            k = j + len(escape)
            if k < len(src) and src[k] == "(":
                end = match_close(src, k)
                if end < 0:
                    return len(src)
                j = end + 1
            else:
                j = k + 1
            continue
        if src.startswith(close, j):
            return j + len(close)
        if not multi and src[j] == "\n":
            return j
        j += 1
    return len(src)


def skip_trivia(src, i):
    """If src[i] starts a comment, string or regex literal, return the index just past it; else i."""
    if src.startswith("//", i):
        end = src.find("\n", i)
        return len(src) if end < 0 else end
    if src.startswith("/*", i):  # Swift block comments nest
        depth, j = 1, i + 2
        while j < len(src) and depth:
            if src.startswith("/*", j):
                depth, j = depth + 1, j + 2
            elif src.startswith("*/", j):
                depth, j = depth - 1, j + 2
            else:
                j += 1
        return j
    if src[i] in '"#':
        end = _string_end(src, i)
        if end != i:
            return end
        if src.startswith("#/", i):  # extended regex literal
            end = src.find("/#", i + 2)
            return len(src) if end < 0 else end + 2
    return i


def match_close(src, open_idx):
    """Index of the bracket closing the one at open_idx, or -1."""
    pairs = {"{": "}", "(": ")", "[": "]"}
    opener, closer = src[open_idx], pairs[src[open_idx]]
    depth, i = 0, open_idx
    while i < len(src):
        j = skip_trivia(src, i)
        if j != i:
            i = j
            continue
        if src[i] == opener:
            depth += 1
        elif src[i] == closer:
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return -1


def code_mask(src):
    """Copy of src with comments and string literals blanked, for safe regex matching."""
    out, i = list(src), 0
    while i < len(src):
        j = skip_trivia(src, i)
        if j != i:
            for k in range(i, min(j, len(src))):
                if out[k] != "\n":
                    out[k] = " "
            i = j
        else:
            i += 1
    return "".join(out)


PREVIEW_RE = re.compile(r"#Preview\b")
MAIN_RE = re.compile(r"@main\b")
APP_RE = re.compile(r"@main\s+(?:\w+\s+)*?struct\s+(\w+)\s*:\s*([^{]*)\{")
VIEW_STRUCT_RE = re.compile(r"\bstruct\s+(\w+)\s*(?:<[^>{]*>)?\s*:\s*[^{]*\bView\b[^{]*\{")
SCENE_RE = re.compile(r"\b(WindowGroup|Window|DocumentGroup|Settings|MenuBarExtra|ImmersiveSpace|UtilityWindow)\b")


GENERATION_PROPERTY = " @SwiftUI.Environment(\\.__peekGeneration) private var __peekGeneration;"
# Synthesized conformances that a hidden Environment property would break.
SYNTHESIZED_RE = re.compile(r"\b(Equatable|Hashable|Codable|Encodable|Decodable|Comparable)\b")


def _blank(text):
    """Keeps only the newlines of text, so line numbers stay the same."""
    return "\n" * text.count("\n")


def _scene_end(src, start):
    """End of a scene expression `Name(args) { content }` starting at start (before any modifiers)."""
    end = start
    while end < len(src) and (src[end].isalnum() or src[end] == "_"):
        end += 1
    while True:
        j = end
        while j < len(src) and src[j] in " \t\n":
            j += 1
        if j < len(src) and src[j] in "({" and (src[j] == "{" or j == end):
            close = match_close(src, j)
            if close < 0:
                return end
            end = close + 1
            if src[j] == "{":
                return end
        else:
            return end


def _rewrite_app(src, mask, m, edits):
    """The @main App at match m becomes a view showing its first window's content."""
    close = match_close(src, m.end() - 1)
    conformance = re.search(r"\bApp\b", m.group(2))
    if not conformance or close < 0:
        return None
    start = m.start(2) + conformance.start()
    edits.append((start, start + 3, "SwiftUI.View"))
    for scene in re.finditer(r"\bsome\s+Scene\b", mask[m.end():close]):
        edits.append((m.end() + scene.start(), m.end() + scene.end(), "some SwiftUI.View"))
    for adaptor in re.finditer(r"@UIApplicationDelegateAdaptor\b", mask[m.end():close]):
        edits.append((m.end() + adaptor.start(), m.end() + adaptor.end(), "@__PeekDelegateAdaptor"))
    body = re.search(r"\bvar\s+body\s*:\s*some\s+Scene\s*\{", mask[m.end():close])
    if not body:
        return m.group(1)
    body_start = m.end() + body.end()
    body_end = match_close(src, body_start - 1)
    first, done = True, body_start
    for scene in SCENE_RE.finditer(mask[body_start:body_end]):
        begin = body_start + scene.start()
        if begin < done or mask[begin - 1] == "." or mask[begin - 1].isalnum():
            continue  # inside an earlier scene, or a member such as `.Settings`
        end = done = _scene_end(src, begin)
        if first and scene.group(1) == "WindowGroup":
            # WindowGroup("Title", id: ...) arguments mean nothing to a view.
            name_end = body_start + scene.end()
            body = name_end
            while body < end and src[body] in " \t\n":
                body += 1
            if src[body:body + 1] == "(":
                body = match_close(src, body) + 1
            edits.append((begin, body, "SwiftUI.Group" + _blank(src[begin:body])))
        elif first and scene.group(1) == "DocumentGroup":
            # A stand-in that opens one new, unsaved document (see SUPPORT_SOURCE).
            edits.append((begin, begin + len("DocumentGroup"), "__PeekDocumentGroup"))
        elif first:
            continue  # e.g. Window, Settings: not on iOS, left as is
        else:
            # Further windows, settings and other scenes are not shown.
            edits.append((begin, end, "SwiftUI.EmptyView()" + _blank(src[begin:end])))
        first = False
    return m.group(1)


def _rewrite_preview(src, m, name):
    """The `#Preview` at match m as (start, end, struct source, title), or None."""
    i = m.end()
    while i < len(src) and src[i] in " \t":
        i += 1
    title = None
    if i < len(src) and src[i] == "(":
        close = match_close(src, i)
        if close < 0:
            return None
        t = re.match(r'\(\s*"((?:[^"\\]|\\.)*)"', src[i:close + 1])
        title = t.group(1) if t else None
        i = close + 1
        while i < len(src) and src[i] in " \t\n":
            i += 1
    if i >= len(src) or src[i] != "{":
        return None
    close = match_close(src, i)
    if close < 0:
        return None
    lines = src[i + 1:close].split("\n")
    masked = code_mask(src[i + 1:close]).split("\n")
    body_open, depth = False, 0
    for n, line in enumerate(lines):
        code = masked[n]
        if depth > 0:  # continuation of a multi-line @Previewable declaration
            depth += sum(code.count(c) for c in "([{") - sum(code.count(c) for c in ")]}")
            continue
        if not code.strip():
            continue
        if code.strip().startswith("@Previewable"):
            lines[n] = line.replace("@Previewable", "", 1)
            depth = sum(code.count(c) for c in "([{") - sum(code.count(c) for c in ")]}")
            continue
        lines[n] = "var body: some SwiftUI.View { __peekPreview { " + line
        body_open = True
        break
    if not body_open:
        return None
    head = f"struct {name}: SwiftUI.View {{{GENERATION_PROPERTY}" + _blank(src[m.start():i])  # keep line numbers stable
    return m.start(), close + 1, head + "\n".join(lines) + "} } }", title


def rewrite_source(src, tag="0"):
    """Makes a source file previewable without changing its line numbers.

    - each `#Preview { ... }` becomes a view struct `__PeekRoot_<tag>_<n>` the entry point can show
      (its body may build a SwiftUI view, a UIViewController or a UIView);
    - the `@main` App becomes a plain view showing its first WindowGroup's content, so a whole
      app can be previewed even when it has no #Preview.
    Returns (new_source, [(struct_name, title or None)], app_struct_name or None).
    """
    roots, app = [], None
    mask = code_mask(src)
    edits = []  # (start, end, replacement)
    for m in MAIN_RE.finditer(mask):
        edits.append((m.start(), m.end(), " " * (m.end() - m.start())))
    for m in APP_RE.finditer(mask):
        app = _rewrite_app(src, mask, m, edits) or app
    spans = []
    for m in PREVIEW_RE.finditer(mask):
        name = f"__PeekRoot_{tag}_{len(roots)}"
        found = _rewrite_preview(src, m, name)
        if found:
            start, end, text, title = found
            edits.append((start, end, text))
            spans.append((start, end))
            roots.append((name, title))
    # Every View struct reads the hot-patch generation, so a patch can make it re-render.
    for m in VIEW_STRUCT_RE.finditer(mask):
        if SYNTHESIZED_RE.search(m.group(0)) or any(a <= m.start() < b for a, b in spans):
            continue
        edits.append((m.end(), m.end(), GENERATION_PROPERTY))
    if app:
        opening = next(m for m in APP_RE.finditer(mask) if m.group(1) == app)
        edits.append((opening.end(), opening.end(), GENERATION_PROPERTY))
    for start, end, text in sorted(edits, reverse=True):
        src = src[:start] + text + src[end:]
    return src, roots, app


# ------------------------------------------------------------ hot patching
#
# A full build is compiled so that every function can be replaced later (implicit dynamic
# replacement, as Xcode previews do). When an edit only changes the bodies of functions and
# computed properties, peek compiles just those bodies into a small "patch" library made of
# @_dynamicReplacement thunks. The phone loads it next to the running build, so views keep
# their identity and their @State; every view then re-renders because it reads a generation
# number from the environment that the patch bumps. Anything else falls back to a full build.

HOT_FLAGS = ["-Xfrontend", "-enable-implicit-dynamic", "-Xfrontend", "-enable-private-imports",
             "-Xfrontend", "-enable-dynamic-replacement-chaining", "-enable-testing"]
_MODIFIER = (r"(?:@[A-Za-z_][\w.]*(?:\((?:[^()]|\([^()]*\))*\))?"
             r"|(?:private|fileprivate|internal|public|open|package)(?:\s*\(\s*set\s*\))?"
             r"|static|class|final|override|mutating|nonmutating|nonisolated|dynamic|lazy|required"
             r"|convenience|optional|weak|unowned|distributed)")
_PREFIX_RE = re.compile(rf"(?:{_MODIFIER}\s*)*$")
_FUNC_RE = re.compile(r"\bfunc\s+([^\s(<]+)")
_VAR_RE = re.compile(r"\bvar\s+([A-Za-z_]\w*)\s*:([^=]+?)\s*$", re.S)
_TYPE_RE = re.compile(r"\b(struct|class|enum|extension|actor|protocol)\s+([A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*)")
_IMPORT_RE = re.compile(r"^[ \t]*(?:@[\w]+(?:\([^)\n]*\))?\s+)*import\s+(?:(?:struct|class|enum|protocol|func|var|typealias)\s+)?[\w.]+[ \t]*$", re.M)
_DROPPED = {"private", "fileprivate", "internal", "public", "open", "package", "override", "final", "dynamic",
            "required", "convenience", "lazy", "optional", "@objc", "@IBAction", "@IBOutlet", "@inlinable",
            "@usableFromInline", "@nonobjc"}


def comment_mask(src):
    """Copy of src with only the comments blanked (string literals are kept)."""
    out, i = list(src), 0
    while i < len(src):
        j = skip_trivia(src, i)
        if j != i:
            if src.startswith("//", i) or src.startswith("/*", i):
                for k in range(i, j):
                    if out[k] != "\n":
                        out[k] = " "
            i = j
        else:
            i += 1
    return "".join(out)


def swift_members(src):
    """The functions and computed properties of a source file whose bodies a patch can replace.

    Returns (skeleton, members). The skeleton is the file without those bodies (and without
    comments); two versions of a file with the same skeleton differ only inside such bodies.
    Each member is a dict: kind, name, prefix, signature, body, context, where.
    """
    mask, plain = code_mask(src), comment_mask(src)
    members, cuts = [], []

    def walk(start, end, context, where):
        i = start
        while True:
            j = mask.find("{", i, end)
            if j < 0:
                return
            close = match_close(src, j)
            if close < 0 or close >= end:
                return
            head_start = max(start, *(mask.rfind(c, start, j) + 1 for c in ";{}"))
            header = mask[head_start:j]
            func, var, typ = _FUNC_RE.search(header), None, None
            if not func and not re.search(r"\b(init|deinit|subscript)\b", header):
                var = _VAR_RE.search(header)
                if not var:
                    typ = _TYPE_RE.search(header)
            keyword = func or var
            if keyword:
                prefix = _PREFIX_RE.search(header[:keyword.start()])
                lead = head_start + (prefix.start() if prefix else keyword.start())
                members.append({
                    "kind": "func" if func else "var", "name": keyword.group(1),
                    "prefix": " ".join(plain[lead:head_start + keyword.start()].split()),
                    "signature": (plain[head_start + keyword.end():j] if func else
                                  plain[head_start + var.start(2):head_start + var.end(2)]).strip(),
                    "body": src[j + 1:close], "context": context, "where": where,
                })
                cuts.append((j + 1, close))
            elif typ and typ.group(1) != "protocol":
                kind, name = typ.group(1), typ.group(2)
                inner_where = None
                if kind == "extension":
                    w = re.search(r"\bwhere\b.*$", plain[head_start + typ.end():j], re.S)
                    inner_where = " ".join(w.group(0).split()) if w else None
                    inner = name
                else:
                    inner = f"{context}.{name}" if context else name
                walk(j + 1, close, inner, inner_where)
            i = close + 1

    walk(0, len(src), None, None)
    pieces, last = [], 0
    for a, b in cuts:
        pieces.append(plain[last:a])
        last = b
    pieces.append(plain[last:])
    return " ".join("".join(pieces).split()), members


def _split_top(text, sep=","):
    """Splits text at sep characters that are not nested in brackets."""
    parts, depth, current, i = [], 0, "", 0
    while i < len(text):
        c = text[i]
        if text.startswith("->", i):
            current += "->"
            i += 2
            continue
        if c in "([<{":
            depth += 1
        elif c in ")]>}":
            depth -= 1
        if c == sep and depth == 0:
            parts.append(current)
            current = ""
        else:
            current += c
        i += 1
    if current.strip():
        parts.append(current)
    return parts


def replacement(member, n):
    """Source of an @_dynamicReplacement thunk for member with its current body, or None."""
    words = member["prefix"].split()
    attrs = [w for w in words if w.startswith("@") and w.split("(")[0] not in _DROPPED]
    mods = [w for w in words if not w.startswith("@") and w.split("(")[0] not in _DROPPED]
    name, signature, body = member["name"], member["signature"], member["body"]
    builder = name == "body" and "some" in signature and not any("Builder" in a for a in attrs)
    if member["kind"] == "var":
        target, decl = name, f"var __peekr{n}_{name}: {signature}"
    else:
        if not re.fullmatch(r"[A-Za-z_]\w*", name):
            return None  # operators
        generics = ""
        rest = signature
        if rest.startswith("<"):
            close = rest.find(">")
            generics, rest = rest[:close + 1], rest[close + 1:].lstrip()
        if not rest.startswith("("):
            return None
        end = match_close(rest, 0)
        if end < 0:
            return None
        params, labels = [], []
        for param in _split_top(rest[1:end]):
            param = _split_top(param, "=")[0].strip()
            names = param.split(":", 1)[0].split()
            if not names:
                return None
            labels.append(names[0])
            params.append(param)
        target = f"{name}({''.join(label + ':' for label in labels)})"
        decl = f"func __peekr{n}_{name}{generics}({', '.join(params)}){rest[end + 1:]}"
    lines = [f"@_dynamicReplacement(for: {target})"] + attrs + (["@SwiftUI.ViewBuilder"] if builder else [])
    return "\n".join(lines) + "\n" + " ".join(["private", *mods, decl]) + " {" + body + "}"


def patch_sources(old, new, file_name, n):
    """Thunk source for a file edited from old to new, or None when it cannot be patched."""
    old_skeleton, old_members = swift_members(old)
    new_skeleton, new_members = swift_members(new)
    if old_skeleton != new_skeleton or len(old_members) != len(new_members):
        return None
    groups = {}
    for before, after in zip(old_members, new_members):
        if before["body"] == after["body"]:
            continue
        text = replacement(after, n)
        if text is None:
            return None
        groups.setdefault((after["context"], after["where"]), []).append(text)
    imports = [line.strip() for line in _IMPORT_RE.findall(comment_mask(new))]
    out = [f"// Generated by peek: hot patch for {file_name}",
           f'@_private(sourceFile: "{file_name}") import PeekPreview', *imports, ""]
    for (context, where), texts in groups.items():
        body = "\n\n".join(texts)
        if context is None:
            out.append(body)
        else:
            out.append(f"extension {context}{' ' + where if where else ''} {{\n{body}\n}}")
        out.append("")
    return "\n".join(out), sum(len(t) for t in groups.values())


