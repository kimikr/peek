        // by the bundle identifier of the app hosting Peek (LiveContainer's, say), whose
        // Info.plist sits next to the executable.
        let executable = URL(fileURLWithPath: CommandLine.arguments[0]).deletingLastPathComponent()
        let host = NSDictionary(contentsOf: executable.appendingPathComponent("Info.plist"))?["CFBundleIdentifier"] as? String
        __peekTargetBundle = host ?? __peekTargetBundleIdentifier
        config.setValue(__peekTargetBundle, forKey: "targetApplicationBundleID")
        config.setValue(executable.path, forKey: "targetApplicationPath")
        _ = (configClass as AnyObject).perform(NSSelectorFromString("setActiveTestConfiguration:"), with: config)
    }
    // launch() would terminate the app, i.e. Peek: start the preview afresh instead, and let
    // terminate() take it off screen. Other apps (Settings, say) launch and quit for real.
    if let application = NSClassFromString("XCUIApplication") {
        func replace<Block>(_ name: String, _ make: (IMP) -> Block) {
            guard let original = __peekOriginal(application, name),
                  let method = class_getInstanceMethod(application, NSSelectorFromString(name)) else { return }
            method_setImplementation(method, imp_implementationWithBlock(make(original)))
        }
        typealias Call = @convention(c) (AnyObject, Selector) -> Void
        typealias State = @convention(c) (AnyObject, Selector) -> UInt
        let activate = __peekOriginal(application, "activate")
        let stateOf = __peekOriginal(application, "state")
        __peekActivate = { app in
            // An app testmanagerd launches never loads its accessibility server; one opened the
            // usual way (as from the Home Screen) does. So a quit app is opened first.
            let state = { stateOf.map { unsafeBitCast($0, to: State.self)(app, NSSelectorFromString("state")) } ?? 4 }
            if !__peekIsTarget(app), state() <= 1, let bundle = app.value(forKey: "bundleID") as? String,
               let workspace = (NSClassFromString("LSApplicationWorkspace") as AnyObject?)?.perform(NSSelectorFromString("defaultWorkspace"))?.takeUnretainedValue() {
                _ = workspace.perform(NSSelectorFromString("openApplicationWithBundleID:"), with: bundle)
                let deadline = Date().addingTimeInterval(10)
                while state() <= 1, Date() < deadline { RunLoop.current.run(until: Date().addingTimeInterval(0.1)) }
                RunLoop.current.run(until: Date().addingTimeInterval(1))  // its first screen
            }
            activate.map { unsafeBitCast($0, to: Call.self)(app, NSSelectorFromString("activate")) }
        }
        replace("launch") { _ -> @convention(block) (AnyObject) -> Void in { app in
            // Another app launched by testmanagerd never loads its accessibility server (the test
            // then waits 60 s and fails), so it is brought to the front instead, as activate() does.
            guard __peekIsTarget(app) else { return __peekActivate(app) }
            __peekRelaunch(app)
        } }
        replace("activate") { original -> @convention(block) (AnyObject) -> Void in { app in
            if __peekIsTarget(app), __peekTerminated { return __peekRelaunch(app) }  // activate() launches a quit app
            if !__peekIsTarget(app) { return __peekActivate(app) }
            unsafeBitCast(original, to: Call.self)(app, NSSelectorFromString("activate"))
        } }
        replace("terminate") { original -> @convention(block) (AnyObject) -> Void in { app in
            guard __peekIsTarget(app) else { return unsafeBitCast(original, to: Call.self)(app, NSSelectorFromString("terminate")) }
            __peekTerminated = true
            NotificationCenter.default.post(name: __peekTerminateNotification, object: nil)
            RunLoop.current.run(until: Date().addingTimeInterval(0.3))
        } }
        typealias Wait = @convention(c) (AnyObject, Selector, UInt, Double) -> Bool
        replace("waitForState:timeout:") { original -> @convention(block) (AnyObject, UInt, Double) -> Bool in { app, state, timeout in
            if __peekIsTarget(app), __peekTerminated { return state == 1 }  // wait(for: .notRunning) after terminate()
            return unsafeBitCast(original, to: Wait.self)(app, NSSelectorFromString("waitForState:timeout:"), state, timeout)
        } }
        replace("state") { original -> @convention(block) (AnyObject) -> UInt in { app in
            if __peekIsTarget(app), __peekTerminated { return 1 }  // XCUIApplication.State.notRunning
            return unsafeBitCast(original, to: State.self)(app, NSSelectorFromString("state"))
        } }
    }
