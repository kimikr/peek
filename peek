"""

# The Peek app unpacks resource bundles on the phone and points this variable at their folder.
# SwiftPM's own generated accessor (used by dependencies) honours the same variable in debug builds.
BUNDLE_TEMPLATE = """
extension Foundation.Bundle {
    static let module: Bundle = {
