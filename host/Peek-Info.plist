<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleShortVersionString</key>
    <string>0.2.1</string>
    <key>CFBundleVersion</key>
    <string>5</string>
    <key>CFBundleDisplayName</key>
    <string>Peek</string>
    <!-- Previews show the translations of their own bundles: iOS only picks a language for those
         that the app itself lists, so Peek lists every language iOS offers. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ar</string>
        <string>ca</string>
        <string>cs</string>
        <string>da</string>
        <string>de</string>
        <string>el</string>
        <string>en-AU</string>
        <string>en-GB</string>
        <string>en-IN</string>
        <string>es</string>
        <string>es-419</string>
        <string>fi</string>
        <string>fr</string>
        <string>fr-CA</string>
        <string>he</string>
        <string>hi</string>
        <string>hr</string>
        <string>hu</string>
        <string>id</string>
        <string>it</string>
        <string>ja</string>
        <string>kk</string>
        <string>ko</string>
        <string>ms</string>
        <string>nb</string>
        <string>nl</string>
        <string>pl</string>
        <string>pt-BR</string>
        <string>pt-PT</string>
        <string>ro</string>
        <string>ru</string>
        <string>sk</string>
        <string>sl</string>
        <string>sv</string>
        <string>th</string>
        <string>tr</string>
        <string>uk</string>
        <string>vi</string>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
        <string>zh-HK</string>
    </array>
    <!-- peek://connect?... pairing links and the certificate callback from SideStore/AltStore -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>kim.jihwan.peek</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>peek</string>
            </array>
        </dict>
    </array>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>sidestore</string>
        <string>altstore-classic</string>
    </array>
    <!-- The dev server is plain HTTP on the LAN or a Tailscale address -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSBonjourServices</key>
    <array>
        <string>_peek._tcp</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Peek connects to the peek dev server on your computer to load previews.</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
