<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>3</string>
    <key>CFBundleDisplayName</key>
    <string>Peek</string>
    <!-- peek://connect?... pairing links and the certificate callback from SideStore/AltStore -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>3</string>
            <key>CFBundleURLName</key>
            <string>kim.jihwan.peek</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>peek</string>
            </array>
        </dict>
    </array>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>sidestore</string>
        <string>altstore-classic</string>
    </array>
    <!-- The dev server is plain HTTP on the LAN or a Tailscale address -->
    <key>NSAppTransportSecurity</key>
    <dict>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>3</string>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSBonjourServices</key>
    <array>
        <string>_peek._tcp</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Peek connects to the peek dev server on your computer to load previews.</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
